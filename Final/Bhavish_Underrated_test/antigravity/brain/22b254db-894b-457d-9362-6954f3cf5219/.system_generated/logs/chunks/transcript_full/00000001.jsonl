{"step_index":33,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-22T11:11:40Z","thinking":"**Crafting Map Styles**\n\nI've got `css/main.css` completed. Now, I'm diving into `css/map.css`. The plan is custom styling for the Leaflet map: a dark/editorial aesthetic, unique SVG markers differentiating Famous from Underrated destinations, glowing pulsing beacons, and a custom popup design.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/* ==========================================================================\n   JHARKHAND TOURISM - CUSTOM LEAFLET MAP & MARKER STYLES\n   ========================================================================== */\n\n/* Leaflet Container Styling */\n.leaflet-container {\n  background-color: #061A13 !important;\n  font-family: 'Plus Jakarta Sans', sans-serif !important;\n}\n\n/* Custom Carto Tile filter for deep luxury forest tone */\n.leaflet-tile-pane {\n  filter: brightness(0.8) contrast(1.15) saturate(1.1) hue-rotate(-15deg);\n}\n\n/* Custom Marker Pin Styling */\n.custom-map-marker {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n.custom-map-marker:hover {\n  transform: scale(1.2) translateY(-4px);\n  z-index: 1000 !important;\n}\n\n.marker-pin {\n  width: 38px;\n  height: 38px;\n  border-radius: 50% 50% 50% 0;\n  transform: rotate(-45deg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);\n  position: relative;\n}\n\n.marker-icon-inner {\n  transform: rotate(45deg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #061A13;\n}\n\n.marker-icon-inner svg {\n  width: 18px;\n  height: 18px;\n}\n\n/* Famous Marker - Gold Palette */\n.custom-map-marker.marker-famous .marker-pin {\n  background: linear-gradient(135deg, #DFC27D 0%, #C5A059 100%);\n  border: 2px solid #FFFFFF;\n}\n\n.custom-map-marker.marker-famous::after {\n  content: '';\n  position: absolute;\n  bottom: -4px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: rgba(197, 160, 89, 0.4);\n  animation: pulse-ring 2.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;\n  z-index: -1;\n}\n\n/* Underrated Marker - Emerald / Discovery Palette */\n.custom-map-marker.marker-underrated .marker-pin {\n  background: linear-gradient(135deg, #34D399 0%, #10B981 100%);\n  border: 2px solid #FFFFFF;\n}\n\n.custom-map-marker.marker-underrated::after {\n  content: '';\n  position: absolute;\n  bottom: -4px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: rgba(16, 185, 129, 0.4);\n  animation: pulse-ring 2.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite 0.5s;\n  z-index: -1;\n}\n\n@keyframes pulse-ring {\n  0% {\n    transform: translateX(-50%) scale(0.6);\n    opacity: 0.9;\n  }\n  100% {\n    transform: translateX(-50%) scale(2.6);\n    opacity: 0;\n  }\n}\n\n/* --------------------------------------------------------------------------\n   CUSTOM LEAFLET POPUP CARD\n   -------------------------------------------------------------------------- */\n.leaflet-popup-content-wrapper {\n  background: rgba(7, 31, 23, 0.95) !important;\n  backdrop-filter: blur(20px) !important;\n  -webkit-backdrop-filter: blur(20px) !important;\n  border: 1px solid rgba(197, 160, 89, 0.35) !important;\n  border-radius: 12px !important;\n  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.8) !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n  color: #EDE8DE !important;\n}\n\n.leaflet-popup-content {\n  margin: 0 !important;\n  line-height: 1.4 !important;\n  width: 280px !important;\n}\n\n.leaflet-popup-tip {\n  background: rgba(7, 31, 23, 0.95) !important;\n  border: 1px solid rgba(197, 160, 89, 0.35) !important;\n}\n\n.leaflet-container a.leaflet-popup-close-button {\n  top: 10px !important;\n  right: 10px !important;\n  color: #FFFFFF !important;\n  background: rgba(0, 0, 0, 0.5) !important;\n  border-radius: 50% !important;\n  width: 24px !important;\n  height: 24px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  border: 1px solid rgba(255, 255, 255, 0.2) !important;\n  font-size: 14px !important;\n  transition: all 0.2s ease !important;\n  z-index: 10 !important;\n}\n\n.leaflet-container a.leaflet-popup-close-button:hover {\n  background: #C5A059 !important;\n  color: #061A13 !important;\n  border-color: #C5A059 !important;\n}\n\n/* Inside Popup Structure */\n.map-popup-card {\n  display: flex;\n  flex-direction: column;\n}\n\n.map-popup-thumb-wrap {\n  position: relative;\n  width: 100%;\n  height: 135px;\n  overflow: hidden;\n}\n\n.map-popup-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.map-popup-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(7, 31, 23, 0.95) 0%, transparent 60%);\n}\n\n.map-popup-type-badge {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  padding: 3px 8px;\n  border-radius: 9999px;\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  background: rgba(0, 0, 0, 0.6);\n  backdrop-filter: blur(8px);\n}\n\n.map-popup-type-badge.famous {\n  color: #DFC27D;\n  border: 1px solid rgba(197, 160, 89, 0.5);\n}\n\n.map-popup-type-badge.underrated {\n  color: #34D399;\n  border: 1px solid rgba(16, 185, 129, 0.5);\n}\n\n.map-popup-info {\n  padding: 12px 14px 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.map-popup-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.15rem;\n  font-weight: 500;\n  color: #FFFFFF;\n  line-height: 1.2;\n}\n\n.map-popup-meta {\n  font-size: 0.75rem;\n  color: #A3B8B0;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.map-popup-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 8px;\n  padding-top: 8px;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  font-size: 0.75rem;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #DFC27D;\n  cursor: pointer;\n  transition: color 0.2s ease;\n}\n\n.map-popup-cta:hover {\n  color: #FFFFFF;\n}\n\n/* Custom Zoom Controls */\n.leaflet-bar {\n  border: 1px solid rgba(255, 255, 255, 0.15) !important;\n  border-radius: 8px !important;\n  overflow: hidden !important;\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;\n}\n\n.leaflet-bar a {\n  background-color: rgba(7, 31, 23, 0.9) !important;\n  color: #EDE8DE !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;\n  transition: background 0.2s ease, color 0.2s ease !important;\n}\n\n.leaflet-bar a:hover {\n  background-color: #C5A059 !important;\n  color: #061A13 !important;\n}\n","Description":"Write map.css with dark luxury tile filters, custom SVG marker pins, and popup styling","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\css\\map.css","toolAction":"Writing map.css","toolSummary":"Writing map.css"}}]}
{"step_index":34,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-22T11:11:48Z","content":"Created At: 2026-08-22T16:41:48+05:30\nCompleted At: 2026-08-22T16:41:49+05:30\nCreated file file:///C:/Users/Bhavish%20Sawant/.gemini/antigravity/scratch/jharkhand-tourism/css/map.css with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":35,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-22T11:11:49Z","thinking":"**Developing Map Interactions**\n\nI'm currently focused on `js/map.js` to handle Leaflet.js map initialization, destination markers, filtering, and animations. The main focus is on the map interactions, ensuring each destination is represented by a marker. I'll need to define distinct styles for Famous and Underrated destinations. I will also have to ensure that when clicking a marker, the camera smoothly flies to its location.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/**\n * Jharkhand Tourism - Interactive Map Controller\n * Leaflet.js integration with custom markers, smooth flyTo camera, and filtering.\n */\n\nlet jharkhandMap = null;\nlet mapMarkers = [];\nlet markerLayerGroup = null;\n\n// Default Geographic Center of Jharkhand\nconst JHARKHAND_CENTER = {\n  lat: 23.6102,\n  lng: 85.2799,\n  defaultZoom: 8,\n  focusZoom: 12\n};\n\n/**\n * Initialize the Leaflet Map with CartoDB Dark Matter / Voyager tiles\n */\nfunction initJharkhandMap() {\n  const mapElement = document.getElementById(\"jharkhand-map\");\n  if (!mapElement) return;\n\n  // Initialize Map\n  jharkhandMap = L.map(\"jharkhand-map\", {\n    center: [JHARKHAND_CENTER.lat, JHARKHAND_CENTER.lng],\n    zoom: JHARKHAND_CENTER.defaultZoom,\n    minZoom: 6,\n    maxZoom: 17,\n    zoomControl: true,\n    scrollWheelZoom: false // Prevent accidental scrolling while browsing page\n  });\n\n  // Enable scroll zoom only after user clicks/focuses on map\n  jharkhandMap.on(\"focus\", () => jharkhandMap.scrollWheelZoom.enable());\n  jharkhandMap.on(\"blur\", () => jharkhandMap.scrollWheelZoom.disable());\n\n  // Base Map Layer (CartoDB Dark Matter for luxury night aesthetic)\n  L.tileLayer(\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\", {\n    attribution: '&copy; <a href=\"https://carto.com/\">CARTO</a> | &copy; Jharkhand Tourism',\n    subdomains: \"abcd\",\n    maxZoom: 19\n  }).addTo(jharkhandMap);\n\n  markerLayerGroup = L.layerGroup().addTo(jharkhandMap);\n\n  // Render Markers\n  renderMapMarkers(JHARKHAND_DESTINATIONS);\n\n  // Map Filter Buttons Event Listener\n  setupMapFilterEvents();\n}\n\n/**\n * Render custom SVG markers onto the map\n * @param {Array} destinations\n */\nfunction renderMapMarkers(destinations) {\n  if (!markerLayerGroup) return;\n  markerLayerGroup.clearLayers();\n  mapMarkers = [];\n\n  destinations.forEach((dest) => {\n    const isFamous = dest.type === \"famous\";\n    const markerClass = isFamous ? \"marker-famous\" : \"marker-underrated\";\n    const typeLabel = isFamous ? \"Famous\" : \"Underrated\";\n    const badgeClass = isFamous ? \"famous\" : \"underrated\";\n\n    // Custom Icon SVG markup\n    const customIconHtml = `\n      <div class=\"custom-map-marker ${markerClass}\">\n        <div class=\"marker-pin\">\n          <div class=\"marker-icon-inner\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n              <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n            </svg>\n          </div>\n        </div>\n      </div>\n    `;\n\n    const customIcon = L.divIcon({\n      html: customIconHtml,\n      className: \"custom-leaflet-div-icon\",\n      iconSize: [40, 40],\n      iconAnchor: [20, 38],\n      popupAnchor: [0, -40]\n    });\n\n    // Marker Popup HTML\n    const popupContent = `\n      <div class=\"map-popup-card\">\n        <div class=\"map-popup-thumb-wrap\">\n          <img src=\"${dest.thumbnail}\" alt=\"${dest.name}\" class=\"map-popup-img\" loading=\"lazy\" />\n          <div class=\"map-popup-overlay\"></div>\n          <span class=\"map-popup-type-badge ${badgeClass}\">${typeLabel}</span>\n        </div>\n        <div class=\"map-popup-info\">\n          <h4 class=\"map-popup-title\">${dest.name}</h4>\n          <div class=\"map-popup-meta\">\n            <span>${dest.category}</span> • <span>${dest.district}</span>\n          </div>\n          <div class=\"map-popup-cta\" onclick=\"openDestinationModal('${dest.id}')\">\n            <span>Explore Details</span>\n            <span>→</span>\n          </div>\n        </div>\n      </div>\n    `;\n\n    const marker = L.marker([dest.coordinates.lat, dest.coordinates.lng], {\n      icon: customIcon,\n      title: dest.name\n    }).bindPopup(popupContent);\n\n    marker.destinationId = dest.id;\n    marker.destinationData = dest;\n\n    markerLayerGroup.addLayer(marker);\n    mapMarkers.push(marker);\n  });\n}\n\n/**\n * Focus and smooth fly-to on a specific destination\n * @param {string} destinationId\n */\nfunction focusDestinationOnMap(destinationId) {\n  const destination = JHARKHAND_DESTINATIONS.find((d) => d.id === destinationId);\n  if (!destination || !jharkhandMap) return;\n\n  // Scroll to Map Section smoothly\n  const mapSection = document.getElementById(\"map-section\");\n  if (mapSection) {\n    mapSection.scrollIntoView({ behavior: \"smooth\", block: \"center\" });\n  }\n\n  // Smooth camera flyTo\n  setTimeout(() => {\n    jharkhandMap.flyTo(\n      [destination.coordinates.lat, destination.coordinates.lng],\n      JHARKHAND_CENTER.focusZoom,\n      {\n        duration: 1.4,\n        easeLinearity: 0.25\n      }\n    );\n\n    // Open matching marker popup\n    const targetMarker = mapMarkers.find((m) => m.destinationId === destinationId);\n    if (targetMarker) {\n      setTimeout(() => targetMarker.openPopup(), 1200);\n    }\n  }, 350);\n}\n\n/**\n * Reset map view back to entire Jharkhand overview\n */\nfunction resetJharkhandMapView() {\n  if (!jharkhandMap) return;\n  jharkhandMap.closePopup();\n  jharkhandMap.flyTo(\n    [JHARKHAND_CENTER.lat, JHARKHAND_CENTER.lng],\n    JHARKHAND_CENTER.defaultZoom,\n    {\n      duration: 1.2\n    }\n  );\n}\n\n/**\n * Setup filter chip event listeners on the map\n */\nfunction setupMapFilterEvents() {\n  const filterButtons = document.querySelectorAll(\".map-filter-btn\");\n  filterButtons.forEach((btn) => {\n    btn.addEventListener(\"click\", () => {\n      filterButtons.forEach((b) => b.classList.remove(\"active\"));\n      btn.classList.add(\"active\");\n\n      const filterType = btn.dataset.filter;\n      if (filterType === \"all\") {\n        renderMapMarkers(JHARKHAND_DESTINATIONS);\n      } else if (filterType === \"famous\" || filterType === \"underrated\") {\n        const filtered = JHARKHAND_DESTINATIONS.filter((d) => d.type === filterType);\n        renderMapMarkers(filtered);\n      } else if (filterType === \"waterfalls\") {\n        const filtered = JHARKHAND_DESTINATIONS.filter((d) =>\n          d.category.toLowerCase().includes(\"waterfall\")\n        );\n        renderMapMarkers(filtered);\n      } else if (filterType === \"wildlife\") {\n        const filtered = JHARKHAND_DESTINATIONS.filter((d) =>\n          d.category.toLowerCase().includes(\"wildlife\") || d.category.toLowerCase().includes(\"forest\")\n        );\n        renderMapMarkers(filtered);\n      }\n    });\n  });\n\n  const resetBtn = document.querySelector(\".map-reset-btn\");\n  if (resetBtn) {\n    resetBtn.addEventListener(\"click\", () => {\n      filterButtons.forEach((b) => b.classList.remove(\"active\"));\n      document.querySelector('.map-filter-btn[data-filter=\"all\"]')?.classList.add(\"active\");\n      renderMapMarkers(JHARKHAND_DESTINATIONS);\n      resetJharkhandMapView();\n    });\n  }\n}\n\n// Export functions to global scope\nwindow.initJharkhandMap = initJharkhandMap;\nwindow.focusDestinationOnMap = focusDestinationOnMap;\nwindow.resetJharkhandMapView = resetJharkhandMapView;\n","Description":"Write map.js with Leaflet integration, custom markers, and smooth flyTo camera controls","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\js\\map.js","toolAction":"Writing map.js","toolSummary":"Writing map.js"}}]}
{"step_index":36,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-22T11:11:55Z","content":"Created At: 2026-08-22T16:41:55+05:30\nCompleted At: 2026-08-22T16:41:56+05:30\nCreated file file:///C:/Users/Bhavish%20Sawant/.gemini/antigravity/scratch/jharkhand-tourism/js/map.js with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":37,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-22T11:11:56Z","thinking":"**Constructing Core Interactions**\n\nI'm now focusing on the application's core functionality. I've outlined a minimalist preloader that reveals the content after 1.2 seconds with a fade-out. Furthermore, I've got a sticky navigation bar that toggles on scroll. Next, I am thinking of user interactions.\n\n\n**Implementing Navigation Enhancements**\n\nI've transitioned to enhancing the navigation experience. I'm implementing a smooth active highlight in the nav, synced with the viewport, using the `.scrolled` state. Furthermore, I've integrated a mobile menu toggle with drawer behavior. It will close on outside clicks or the escape key.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/**\n * Jharkhand Tourism - Main Application Logic\n * Elevated UI/UX Controller, Modal Manager, Custom Cursor, Audio Generator, and Animations\n */\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  // 1. Initialize Loading Screen\n  initPreloader();\n\n  // 2. Initialize Navigation & Scroll Listeners\n  initNavigation();\n\n  // 3. Render Destinations\n  renderFamousDestinations();\n  renderUnderratedDestinations();\n  renderDidYouKnowFacts();\n  renderTravelThemes();\n\n  // 4. Initialize Category Filters\n  initCategoryFilters();\n\n  // 5. Initialize Desktop Custom Cursor for Destination Cards\n  initCardCursorFollower();\n\n  // 6. Initialize Scroll Reveal Animations (Intersection Observer)\n  initScrollReveals();\n\n  // 7. Initialize Ambient Sound Experience (Web Audio Synthesizer)\n  initNatureSoundSynthesizer();\n\n  // 8. Initialize Leaflet Map\n  if (typeof initJharkhandMap === \"function\") {\n    initJharkhandMap();\n  }\n});\n\n/* ==========================================================================\n   1. PRELOADER CONTROLLER\n   ========================================================================== */\nfunction initPreloader() {\n  const preloader = document.getElementById(\"preloader\");\n  if (!preloader) return;\n\n  window.addEventListener(\"load\", () => {\n    setTimeout(() => {\n      preloader.classList.add(\"hidden\");\n    }, 900);\n  });\n\n  // Fallback safety timeout\n  setTimeout(() => {\n    if (!preloader.classList.contains(\"hidden\")) {\n      preloader.classList.add(\"hidden\");\n    }\n  }, 2500);\n}\n\n/* ==========================================================================\n   2. NAVIGATION CONTROLLER\n   ========================================================================== */\nfunction initNavigation() {\n  const navbar = document.getElementById(\"navbar\");\n  const mobileToggle = document.getElementById(\"mobile-nav-toggle\");\n  const mobileDrawer = document.getElementById(\"mobile-drawer\");\n  const navLinks = document.querySelectorAll(\".nav-link, .mobile-drawer-link\");\n\n  // Scroll event for sticky glass navbar & active state\n  window.addEventListener(\"scroll\", () => {\n    const scrollY = window.scrollY;\n\n    if (scrollY > 50) {\n      navbar?.classList.add(\"scrolled\");\n    } else {\n      navbar?.classList.remove(\"scrolled\");\n    }\n\n    // Update active nav link based on section in view\n    updateActiveNavLink();\n  }, { passive: true });\n\n  // Mobile Drawer Toggle\n  if (mobileToggle && mobileDrawer) {\n    mobileToggle.addEventListener(\"click\", () => {\n      const isOpen = mobileDrawer.classList.contains(\"open\");\n      if (isOpen) {\n        closeMobileDrawer();\n      } else {\n        openMobileDrawer();\n      }\n    });\n\n    // Close mobile drawer when clicking a link\n    navLinks.forEach((link) => {\n      link.addEventListener(\"click\", () => {\n        closeMobileDrawer();\n      });\n    });\n  }\n\n  function openMobileDrawer() {\n    mobileDrawer.classList.add(\"open\");\n    mobileToggle.classList.add(\"open\");\n    mobileToggle.setAttribute(\"aria-expanded\", \"true\");\n    document.body.style.overflow = \"hidden\";\n  }\n\n  function closeMobileDrawer() {\n    mobileDrawer.classList.remove(\"open\");\n    mobileToggle.classList.remove(\"open\");\n    mobileToggle.setAttribute(\"aria-expanded\", \"false\");\n    document.body.style.overflow = \"\";\n  }\n}\n\nfunction updateActiveNavLink() {\n  const sections = document.querySelectorAll(\"section[id]\");\n  const navLinks = document.querySelectorAll(\".nav-link\");\n  const scrollPosition = window.scrollY + 200;\n\n  sections.forEach((section) => {\n    const sectionTop = section.offsetTop;\n    const sectionHeight = section.offsetHeight;\n    const sectionId = section.getAttribute(\"id\");\n\n    if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {\n      navLinks.forEach((link) => {\n        if (link.getAttribute(\"href\") === `#${sectionId}`) {\n          link.classList.add(\"active\");\n        } else {\n          link.classList.remove(\"active\");\n        }\n      });\n    }\n  });\n}\n\n/* ==========================================================================\n   3. DESTINATION CARD CREATION & RENDERING\n   ========================================================================== */\n\n/**\n * Generate HTML string for a destination card adhering to strict hover requirements\n * @param {Object} dest\n * @param {boolean} isUnderrated\n */\nfunction createDestinationCardHtml(dest, isUnderrated = false) {\n  const badgeClass = isUnderrated ? \"badge-underrated\" : \"badge-famous\";\n  const badgeLabel = isUnderrated ? \"Underrated Gem\" : \"Famous\";\n  const cardClass = isUnderrated ? \"underrated-card\" : \"destination-card\";\n\n  return `\n    <article class=\"${cardClass} fade-up\" data-category=\"${dest.category.toLowerCase()}\" data-id=\"${dest.id}\" onclick=\"openDestinationModal('${dest.id}')\" tabindex=\"0\" role=\"button\" aria-label=\"Explore ${dest.name}\">\n      <div class=\"card-media\">\n        <img src=\"${dest.thumbnail}\" alt=\"${dest.name}\" class=\"card-img\" loading=\"lazy\" />\n        <div class=\"card-gradient\"></div>\n      </div>\n\n      <div class=\"card-top-meta\">\n        <span class=\"badge-tag ${badgeClass}\">${badgeLabel}</span>\n        <span class=\"card-district\">${dest.district}</span>\n      </div>\n\n      <div class=\"card-body\">\n        <span class=\"card-category\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/>\n          </svg>\n          ${dest.category}\n        </span>\n        <h3 class=\"card-title\">${dest.name}</h3>\n        <p class=\"card-tagline\">${dest.tagline}</p>\n        \n        <div class=\"card-cta-row\">\n          <span class=\"card-explore-btn\">\n            Explore Destination\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n              <polyline points=\"12 5 19 12 12 19\"></polyline>\n            </svg>\n          </span>\n\n          <button class=\"card-map-action\" title=\"View on Map\" onclick=\"event.stopPropagation(); focusDestinationOnMap('${dest.id}');\" aria-label=\"View ${dest.name} on map\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n              <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </article>\n  `;\n}\n\nfunction renderFamousDestinations() {\n  const famousContainer = document.getElementById(\"famous-destinations-grid\");\n  if (!famousContainer) return;\n\n  const famousItems = JHARKHAND_DESTINATIONS.filter((d) => d.type === \"famous\");\n  famousContainer.innerHTML = famousItems.map((d) => createDestinationCardHtml(d, false)).join(\"\");\n}\n\nfunction renderUnderratedDestinations() {\n  const underratedContainer = document.getElementById(\"underrated-destinations-grid\");\n  if (!underratedContainer) return;\n\n  const underratedItems = JHARKHAND_DESTINATIONS.filter((d) => d.type === \"underrated\");\n  underratedContainer.innerHTML = underratedItems.map((d) => createDestinationCardHtml(d, true)).join(\"\");\n}\n\nfunction renderDidYouKnowFacts() {\n  const factsContainer = document.getElementById(\"facts-container\");\n  if (!factsContainer || typeof DID_YOU_KNOW_FACTS === \"undefined\") return;\n\n  factsContainer.innerHTML = DID_YOU_KNOW_FACTS.map((fact) => `\n    <div class=\"fact-card fade-up\">\n      <div class=\"fact-num\">${fact.number}</div>\n      <div class=\"fact-tag\">${fact.tag}</div>\n      <h3 class=\"fact-headline\">${fact.headline}</h3>\n      <p class=\"fact-body\">${fact.body}</p>\n    </div>\n  `).join(\"\");\n}\n\nfunction renderTravelThemes() {\n  const themesContainer = document.getElementById(\"themes-grid\");\n  if (!themesContainer || typeof TRAVEL_THEMES === \"undefined\") return;\n\n  themesContainer.innerHTML = TRAVEL_THEMES.map((theme) => `\n    <div class=\"theme-card fade-up\">\n      <div class=\"theme-bg\">\n        <img src=\"${theme.image}\" alt=\"${theme.title}\" class=\"theme-img\" loading=\"lazy\" />\n        <div class=\"theme-overlay\"></div>\n      </div>\n      <div class=\"theme-content\">\n        <span class=\"theme-count\">${theme.count}</span>\n        <h3 class=\"theme-title\">${theme.title}</h3>\n        <p class=\"theme-sub\">${theme.subtitle}</p>\n      </div>\n    </div>\n  `).join(\"\");\n}\n\n/* ==========================================================================\n   4. CATEGORY FILTERS\n   ========================================================================== */\nfunction initCategoryFilters() {\n  const filterChips = document.querySelectorAll(\".filter-chip\");\n  const destinationCards = document.querySelectorAll(\".destination-card, .underrated-card\");\n\n  filterChips.forEach((chip) => {\n    chip.addEventListener(\"click\", () => {\n      filterChips.forEach((c) => c.classList.remove(\"active\"));\n      chip.classList.add(\"active\");\n\n      const selectedCategory = chip.dataset.category.toLowerCase();\n\n      document.querySelectorAll(\".destination-card, .underrated-card\").forEach((card) => {\n        const cardCat = card.dataset.category || \"\";\n        if (selectedCategory === \"all\" || cardCat.includes(selectedCategory)) {\n          card.style.display = \"flex\";\n        } else {\n          card.style.display = \"none\";\n        }\n      });\n    });\n  });\n}\n\n/* ==========================================================================\n   5. DESKTOP CUSTOM CURSOR FOLLOWER FOR CARDS\n   ========================================================================== */\nfunction initCardCursorFollower() {\n  const follower = document.getElementById(\"card-cursor-follower\");\n  if (!follower) return;\n\n  // Check if pointer is fine and hover is supported (Desktop only)\n  const isFinePointer = window.matchMedia(\"(hover: hover) and (pointer: fine)\").matches;\n  if (!isFinePointer) return;\n\n  let mouseX = 0, mouseY = 0;\n  let followerX = 0, followerY = 0;\n  let isHoveringCard = false;\n\n  document.addEventListener(\"mousemove\", (e) => {\n    mouseX = e.clientX;\n    mouseY = e.clientY;\n\n    const targetCard = e.target.closest(\".destination-card, .underrated-card, .theme-card\");\n    if (targetCard) {\n      if (!isHoveringCard) {\n        follower.classList.add(\"active\");\n        follower.textContent = targetCard.classList.contains(\"underrated-card\") ? \"DISCOVER\" : \"EXPLORE\";\n        isHoveringCard = true;\n      }\n    } else {\n      if (isHoveringCard) {\n        follower.classList.remove(\"active\");\n        isHoveringCard = false;\n      }\n    }\n  });\n\n  // Smooth fluid trailing animation using requestAnimationFrame\n  function animateFollower() {\n    followerX += (mouseX - followerX) * 0.18;\n    followerY += (mouseY - followerY) * 0.18;\n\n    follower.style.transform = `translate3d(${followerX}px, ${followerY}px, 0) ${isHoveringCard ? 'scale(1)' : 'scale(0.5)'}`;\n    requestAnimationFrame(animateFollower);\n  }\n\n  animateFollower();\n}\n\n/* ==========================================================================\n   6. FULL-SCREEN IMMERSIVE DESTINATION DETAILS MODAL\n   ========================================================================== */\nfunction openDestinationModal(destinationId) {\n  const destination = JHARKHAND_DESTINATIONS.find((d) => d.id === destinationId);\n  if (!destination) return;\n\n  const modalBackdrop = document.get