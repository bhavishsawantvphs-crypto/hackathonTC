gold-dim);\n  transform: translateY(-2px);\n}\n\n.audio-toggle-btn.playing {\n  border-color: var(--emerald-accent);\n  color: var(--emerald-accent);\n  background: var(--emerald-glow);\n  box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);\n}\n\n.audio-wave {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  height: 12px;\n}\n\n.audio-bar {\n  width: 2px;\n  height: 100%;\n  background: currentColor;\n  border-radius: 1px;\n  animation: none;\n}\n\n.audio-toggle-btn.playing .audio-bar:nth-child(1) { animation: wave 0.8s ease-in-out infinite alternate; }\n.audio-toggle-btn.playing .audio-bar:nth-child(2) { animation: wave 1.1s ease-in-out infinite 0.2s alternate; }\n.audio-toggle-btn.playing .audio-bar:nth-child(3) { animation: wave 0.9s ease-in-out infinite 0.4s alternate; }\n\n@keyframes wave {\n  0% { height: 3px; }\n  100% { height: 12px; }\n}\n\n/* Primary CTA Button with Magnetic Glide */\n.btn-primary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.75rem;\n  background: var(--gold-prime);\n  color: #061A13;\n  font-weight: 600;\n  font-size: 0.82rem;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 0.85rem 1.6rem;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--gold-prime);\n  transition: all var(--transition-normal);\n  position: relative;\n  overflow: hidden;\n  box-shadow: 0 8px 20px -5px rgba(197, 160, 89, 0.35);\n}\n\n.btn-primary::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: -100%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);\n  transition: left 0.6s ease;\n}\n\n.btn-primary:hover {\n  background: var(--gold-light);\n  border-color: var(--gold-light);\n  transform: translateY(-2px);\n  box-shadow: 0 12px 30px -5px rgba(197, 160, 89, 0.5);\n}\n\n.btn-primary:hover::before {\n  left: 100%;\n}\n\n.btn-primary .btn-arrow {\n  transition: transform var(--transition-fast);\n}\n\n.btn-primary:hover .btn-arrow {\n  transform: translateX(5px);\n}\n\n/* Secondary Button / Outline */\n.btn-secondary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.75rem;\n  background: transparent;\n  color: var(--text-pure);\n  font-weight: 500;\n  font-size: 0.82rem;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 0.85rem 1.6rem;\n  border-radius: var(--radius-sm);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  transition: all var(--transition-normal);\n  backdrop-filter: blur(8px);\n}\n\n.btn-secondary:hover {\n  border-color: var(--gold-prime);\n  color: var(--gold-prime);\n  background: rgba(197, 160, 89, 0.08);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.5);\n}\n\n/* Mobile Hamburger Toggle */\n.mobile-nav-toggle {\n  display: none;\n  flex-direction: column;\n  justify-content: center;\n  gap: 6px;\n  width: 44px;\n  height: 44px;\n  padding: 8px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--glass-border);\n  background: rgba(255, 255, 255, 0.03);\n  z-index: 1001;\n}\n\n.mobile-nav-toggle span {\n  display: block;\n  height: 2px;\n  width: 100%;\n  background: var(--text-pure);\n  border-radius: 1px;\n  transition: all var(--transition-normal);\n}\n\n.mobile-nav-toggle.open span:nth-child(1) {\n  transform: translateY(8px) rotate(45deg);\n}\n.mobile-nav-toggle.open span:nth-child(2) {\n  opacity: 0;\n}\n.mobile-nav-toggle.open span:nth-child(3) {\n  transform: translateY(-8px) rotate(-45deg);\n}\n\n/* Mobile Navigation Drawer */\n.mobile-drawer {\n  position: fixed;\n  inset: 0;\n  background: rgba(4, 15, 11, 0.98);\n  backdrop-filter: blur(25px);\n  -webkit-backdrop-filter: blur(25px);\n  z-index: 999;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: 3rem 2rem;\n  transform: translateX(100%);\n  transition: transform 0.6s var(--ease-luxury);\n  pointer-events: none;\n}\n\n.mobile-drawer.open {\n  transform: translateX(0);\n  pointer-events: auto;\n}\n\n.mobile-drawer-links {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 1.75rem;\n  margin-bottom: 2.5rem;\n}\n\n.mobile-drawer-link {\n  font-family: var(--font-serif);\n  font-size: 2rem;\n  color: var(--text-main);\n  text-decoration: none;\n  transition: color var(--transition-fast);\n}\n\n.mobile-drawer-link:hover,\n.mobile-drawer-link.active {\n  color: var(--gold-prime);\n}\n\n/* --------------------------------------------------------------------------\n   HERO SECTION (CINEMATIC FULLSCREEN)\n   -------------------------------------------------------------------------- */\n.hero {\n  position: relative;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  overflow: hidden;\n  padding: 8rem 1.5rem 5rem;\n}\n\n.hero-bg-container {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.hero-bg-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  animation: var(--transition-kenburns);\n  transform-origin: center center;\n  filter: brightness(0.85);\n  will-change: transform;\n}\n\n/* Glowing Ambient Floating Orbs in Hero */\n.hero-orb {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(80px);\n  opacity: 0.35;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.hero-orb-1 {\n  top: 15%;\n  left: 20%;\n  width: 320px;\n  height: 320px;\n  background: radial-gradient(circle, #C5A059, transparent 70%);\n  animation: float-orb 12s ease-in-out infinite alternate;\n}\n\n.hero-orb-2 {\n  bottom: 20%;\n  right: 15%;\n  width: 400px;\n  height: 400px;\n  background: radial-gradient(circle, #10B981, transparent 70%);\n  animation: float-orb 16s ease-in-out infinite 2s alternate-reverse;\n}\n\n@keyframes float-orb {\n  0% { transform: translate(0, 0) scale(1); }\n  100% { transform: translate(40px, -30px) scale(1.15); }\n}\n\n/* Dark Editorial Gradient Vignette */\n.hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at center, rgba(6, 26, 19, 0.45) 0%, rgba(4, 15, 11, 0.85) 85%),\n              linear-gradient(to bottom, rgba(6, 26, 19, 0.5) 0%, transparent 40%, rgba(6, 26, 19, 0.95) 100%);\n  z-index: 1;\n}\n\n@keyframes kenburns {\n  0% {\n    transform: scale(1) translate(0, 0);\n  }\n  50% {\n    transform: scale(1.08) translate(-1%, -1%);\n  }\n  100% {\n    transform: scale(1.14) translate(1%, 0.5%);\n  }\n}\n\n.hero-content {\n  position: relative;\n  z-index: 2;\n  max-width: 920px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1.5rem;\n  margin-top: 1rem;\n}\n\n.hero-tag {\n  font-family: var(--font-sans);\n  font-size: clamp(0.8rem, 1.2vw, 0.95rem);\n  font-weight: 600;\n  letter-spacing: 0.35em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.hero-tag::before,\n.hero-tag::after {\n  content: '';\n  width: 30px;\n  height: 1px;\n  background: var(--gold-prime);\n}\n\n.hero-title {\n  font-size: clamp(2.75rem, 6.5vw, 5.5rem);\n  font-weight: 400;\n  letter-spacing: -0.02em;\n  color: #FFFFFF;\n  line-height: 1.05;\n  text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);\n}\n\n.hero-title span {\n  font-style: italic;\n  font-weight: 300;\n  color: #F8F5EE;\n}\n\n.hero-subtitle {\n  font-size: clamp(1.1rem, 2vw, 1.45rem);\n  font-weight: 300;\n  color: var(--gold-light);\n  font-family: var(--font-serif);\n  font-style: italic;\n  letter-spacing: 0.02em;\n}\n\n.hero-description {\n  font-size: clamp(0.95rem, 1.2vw, 1.125rem);\n  color: var(--text-main);\n  max-width: 640px;\n  font-weight: 300;\n  opacity: 0.9;\n  line-height: 1.6;\n}\n\n.hero-buttons {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 1.25rem;\n  margin-top: 1.25rem;\n  flex-wrap: wrap;\n}\n\n/* Scroll Indicator */\n.hero-scroll-indicator {\n  position: absolute;\n  bottom: 2rem;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.6rem;\n  text-decoration: none;\n  color: var(--text-muted);\n  font-size: 0.72rem;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  transition: color var(--transition-fast), transform var(--transition-fast);\n}\n\n.hero-scroll-indicator:hover {\n  color: var(--gold-prime);\n  transform: translateX(-50%) translateY(3px);\n}\n\n.scroll-mouse {\n  width: 20px;\n  height: 32px;\n  border: 1.5px solid rgba(255, 255, 255, 0.35);\n  border-radius: 10px;\n  display: flex;\n  justify-content: center;\n  padding-top: 6px;\n}\n\n.scroll-wheel {\n  width: 3px;\n  height: 6px;\n  background: var(--gold-prime);\n  border-radius: 2px;\n  animation: scroll-bob 2s ease-in-out infinite;\n}\n\n@keyframes scroll-bob {\n  0% { transform: translateY(0); opacity: 1; }\n  60% { transform: translateY(8px); opacity: 0; }\n  61% { transform: translateY(0); opacity: 0; }\n  100% { transform: translateY(0); opacity: 1; }\n}\n\n/* --------------------------------------------------------------------------\n   EDITORIAL STATS STRIP / ANIMATED STATS COUNTER\n   -------------------------------------------------------------------------- */\n.stats-strip {\n  border-top: 1px solid var(--glass-border);\n  border-bottom: 1px solid var(--glass-border);\n  background: rgba(11, 36, 27, 0.4);\n  backdrop-filter: blur(10px);\n  padding: 2.5rem 0;\n  position: relative;\n  z-index: 2;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 2rem;\n}\n\n.stat-item {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  border-left: 1px solid rgba(197, 160, 89, 0.25);\n  padding-left: 1.5rem;\n  transition: transform var(--transition-normal);\n}\n\n.stat-item:hover {\n  transform: translateX(4px);\n}\n\n.stat-number {\n  font-family: var(--font-serif);\n  font-size: clamp(2rem, 3.5vw, 2.75rem);\n  font-weight: 500;\n  color: var(--gold-light);\n  line-height: 1;\n}\n\n.stat-label {\n  font-size: 0.8rem;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--text-pure);\n}\n\n.stat-desc {\n  font-size: 0.82rem;\n  color: var(--text-muted);\n  line-height: 1.4;\n}\n\n/* --------------------------------------------------------------------------\n   DESTINATIONS GRID & EDITORIAL CARDS\n   -------------------------------------------------------------------------- */\n.destinations-section {\n  position: relative;\n  background-color: var(--bg-prime);\n}\n\n.filter-bar {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n  margin-bottom: 3rem;\n  padding-bottom: 1rem;\n}\n\n.filter-chip {\n  padding: 0.65rem 1.35rem;\n  border-radius: var(--radius-full);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: rgba(255, 255, 255, 0.02);\n  color: var(--text-muted);\n  font-size: 0.82rem;\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  transition: all 0.35s var(--ease-luxury);\n  position: relative;\n  overflow: hidden;\n}\n\n.filter-chip:hover {\n  border-color: var(--gold-prime);\n  color: var(--text-pure);\n  background: rgba(197, 160, 89, 0.08);\n  transform: translateY(-2px);\n}\n\n.filter-chip.active {\n  border-color: var(--gold-prime);\n  background: var(--gold-prime);\n  color: #061A13;\n  font-weight: 600;\n  box-shadow: 0 4px 15px rgba(197, 160, 89, 0.4);\n}\n\n/* Cards Grid */\n.destinations-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));\n  gap: clamp(1.75rem, 2.5vw, 2.5rem);\n}\n\n/* ==========================================================================\n   DESTINATION CARD (CINEMATIC 3D TILT HOVER & HOVER MECHANICS)\n   ========================================================================== */\n.destination-card {\n  position: relative;\n  height: 500px;\n  border-radius: var(--radius-md);\n  overflow: hidden;\n  background: var(--bg-card);\n  cursor: pointer;\n  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  transition: border-color 0.6s var(--ease-luxury), box-shadow 0.6s var(--ease-luxury), transform 0.6s var(--ease-luxury);\n  will-change: transform, box-shadow;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  transform-style: preserve-3d;\n}\n\n/* Dynamic Specular Sheen Beam sweeping across on hover */\n.destination-card::after {\n  content: '';\n  position: absolute;\n  top: -50%;\n  left: -50%;\n  width: 200%;\n  height: 200%;\n  background: linear-gradient(\n    45deg,\n    transparent 40%,\n    rgba(255, 255, 255, 0.12) 50%,\n    transparent 60%\n  );\n  transform: rotate(-45deg) translateY(-100%);\n  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);\n  pointer-events: none;\n  z-index: 4;\n}\n\n.destination-card:hover::after {\n  transform: rotate(-45deg) translateY(100%);\n}\n\n.destination-card:hover {\n  border-color: rgba(197, 160, 89, 0.5);\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75), 0 0 25px -5px rgba(197, 160, 89, 0.3);\n  transform: translateY(-6px);\n}\n\n/* Image Container */\n.card-media {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.card-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  transform: scale(1);\n  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.8s ease;\n  will-change: transform;\n}\n\n/* Hover Requirement: Zoom scale(1.08) + subtle shift */\n.destination-card:hover .card-img {\n  transform: scale(1.08) translate3d(-1%, -1%, 0);\n  filter: contrast(1.05);\n}\n\n/* Hover Requirement: Dark gradient overlay intensifies */\n.card-gradient {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  background: linear-gradient(\n    to bottom,\n    rgba(6, 26, 19, 0.15) 0%,\n    rgba(6, 26, 19, 0.4) 40%,\n    rgba(4, 15, 11, 0.85) 75%,\n    rgba(4, 15, 11, 0.98) 100%\n  );\n  transition: background 0.6s var(--ease-luxury);\n}\n\n.destination-card:hover .card-gradient {\n  background: linear-gradient(\n    to bottom,\n    rgba(6, 26, 19, 0.25) 0%,\n    rgba(6, 26, 19, 0.55) 35%,\n    rgba(4, 15, 11, 0.92) 70%,\n    rgba(4, 15, 11, 1) 100%\n  );\n}\n\n/* Floating Top Badges */\n.card-top-meta {\n  position: absolute;\n  top: 1.5rem;\n  left: 1.5rem;\n  right: 1.5rem;\n  z-index: 2;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  pointer-events: none;\n}\n\n.badge-famous {\n  padding: 0.35rem 0.85rem;\n  border-radius: var(--radius-full);\n  font-size: 0.72rem;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  background: rgba(197, 160, 89, 0.2);\n  border: 1px solid rgba(197, 160, 89, 0.4);\n  color: var(--gold-light);\n}\n\n.card-district {\n  font-size: 0.75rem;\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  color: var(--text-main);\n  background: rgba(0, 0, 0, 0.5);\n  padding: 0.35rem 0.75rem;\n  border-radius: var(--radius-full);\n  backdrop-filter: blur(8px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n/* Card Body Content */\n.card-body {\n  position: relative;\n  z-index: 2;\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  transform: translateY(0);\n  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n/* Hover: Title moves upward smoothly */\n.destination-card:hover .card-body {\n  transform: translateY(-6px);\n}\n\n.card-category {\n  font-size: 0.78rem;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  opacity: 0.85;\n  transition: opacity 0.4s var(--ease-luxury), transform 0.4s var(--ease-luxury);\n}\n\n.destination-card:hover .card-category {\n  opacity: 1;\n}\n\n.card-title {\n  font-family: var(--font-serif);\n  font-size: 1.65rem;\n  font-weight: 500;\n  color: var(--text-pure);\n  line-height: 1.2;\n}\n\n.card-tagline {\n  font-size: 0.88rem;\n  color: var(--text-muted);\n  line-height: 1.45;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* Hover: Explore -> slides in smoothly + arrow movement */\n.card-cta-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 0.75rem;\n  padding-top: 0.85rem;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.card-explore-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.82rem;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--gold-light);\n  transition: color var(--transition-fast);\n}\n\n.card-explore-btn svg {\n  width: 16px;\n  height: 16px;\n  transition: transform 0.4s var(--ease-luxury);\n}\n\n.destination-card:hover .card-explore-btn svg {\n  transform: translateX(5px);\n}\n\n.card-map-action {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  color: var(--text-muted);\n  transition: all var(--transition-fast);\n}\n\n.card-map-action:hover {\n  background: var(--gold-prime);\n  border-color: var(--gold-prime);\n  color: #061A13;\n  transform: scale(1.15) rotate(12deg);\n}\n\n/* ==========================================================================\n   DESKTOP CUSTOM CURSOR FOLLOWER\n   Active strictly within destination cards\n   ========================================================================== */\n.card-cursor-follower {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 72px;\n  height: 72px;\n  margin-left: -36px;\n  margin-top: -36px;\n  border-radius: 50%;\n  background: rgba(197, 160, 89, 0.9);\n  color: #061A13;\n  font-size: 0.68rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n  z-index: 10000;\n  opacity: 0;\n  transform: scale(0.5);\n  transition: opacity 0.3s var(--ease-luxury), transform 0.3s var(--ease-luxury);\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);\n  backdrop-filter: blur(4px);\n}\n\n.card-cursor-follower.active {\n  opacity: 1;\n  transform: scale(1);\n}\n\n/* --------------------------------------------------------------------------\n   \"DID YOU KNOW?\" EDITORIAL MOMENTS & MICRO-INTERACTIONS\n   -------------------------------------------------------------------------- */\n.editorial-break {\n  position: relative;\n  background: #04120D;\n  border-top: 1px solid var(--glass-border);\n  border-bottom: 1px solid var(--glass-border);\n  overflow: hidden;\n  padding: 5rem 0;\n}\n\n.editorial-break::before {\n  content: '';\n  position: absolute;\n  top: -50%;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 800px;\n  height: 300px;\n  background: radial-gradient(ellipse at center, rgba(197, 160, 89, 0.08) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.fact-carousel-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 2rem;\n}\n\n.fact-card {\n  background: rgba(11, 36, 27, 0.4);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: var(--radius-md);\n  padding: 2.25rem;\n  position: relative;\n  transition: all var(--transition-normal);\n}\n\n.fact-card:hover {\n  border-color: rgba(197, 160, 89, 0.35);\n  background: rgba(11, 36, 27, 0.7);\n  transform: translateY(-4px);\n}\n\n.fact-num {\n  font-family: var(--font-serif);\n  font-size: 2.5rem;\n  font-weight: 400;\n  color: var(--gold-prime);\n  opacity: 0.4;\n  line-height: 1;\n  margin-bottom: 0.5rem;\n}\n\n.fact-tag {\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n  margin-bottom: 0.75rem;\n}\n\n.fact-headline {\n  font-family: var(--font-serif);\n  font-size: 1.25rem;\n  color: var(--text-pure);\n  margin-bottom: 0.75rem;\n  line-height: 1.35;\n}\n\n.fact-body {\n  font-size: 0.88rem;\n  color: var(--text-muted);\n  line-height: 1.6;\n}\n\n/* --------------------------------------------------------------------------\n   INTERACTIVE MAP SECTION\n   -------------------------------------------------------------------------- */\n.map-section {\n  position: relative;\n  background: #051610;\n  border-top: 1px solid var(--glass-border);\n}\n\n.map-wrapper {\n  position: relative;\n  width: 100%;\n  height: 640px;\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  border: 1px solid var(--glass-border);\n  box-shadow: var(--glass-shadow);\n}\n\n#jharkhand-map {\n  width: 100%;\n  height: 100%;\n  background: #081D15;\n  z-index: 1;\n}\n\n.map-controls-bar {\n  position: absolute;\n  top: 1.25rem;\n  left: 1.25rem;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n}\n\n.map-filter-btn {\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-full);\n  background: rgba(6, 26, 19, 0.85);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: var(--text-main);\n  font-size: 0.78rem;\n  font-weight: 500;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  transition: all var(--transition-fast);\n}\n\n.map-filter-btn:hover,\n.map-filter-btn.active {\n  background: var(--gold-prime);\n  border-color: var(--gold-prime);\n  color: #061A13;\n  font-weight: 600;\n  transform: translateY(-1px);\n}\n\n.map-reset-btn {\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-full);\n  background: rgba(6, 26, 19, 0.85);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: var(--text-muted);\n  font-size: 0.78rem;\n  transition: all var(--transition-fast);\n}\n\n.map-reset-btn:hover {\n  color: var(--text-pure);\n  border-color: var(--text-pure);\n  transform: translateY(-1px);\n}\n\n.map-legend {\n  position: absolute;\n  bottom: 1.25rem;\n  right: 1.25rem;\n  z-index: 10;\n  background: rgba(6, 26, 19, 0.9);\n  backdrop-filter: blur(16px);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--radius-md);\n  padding: 0.85rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.75rem;\n  color: var(--text-main);\n}\n\n.legend-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--gold-prime);\n  box-shadow: 0 0 10px var(--gold-prime);\n}\n\n/* --------------------------------------------------------------------------\n   TRAVEL EXPERIENCES & CURATED THEMES\n   -------------------------------------------------------------------------- */\n.themes-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 1.75rem;\n}\n\n.theme-card {\n  position: relative;\n  height: 380px;\n  border-radius: var(--radius-md);\n  overflow: hidden;\n  border: 1px solid var(--glass-border);\n  box-shadow: var(--glass-shadow);\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  padding: 2rem;\n  transition: all var(--transition-normal);\n}\n\n.theme-card:hover {\n  transform: translateY(-5px);\n  border-color: var(--gold-prime);\n  box-shadow: 0 25px 45px -10px rgba(0, 0, 0, 0.8), 0 0 20px -5px rgba(197, 160, 89, 0.25);\n}\n\n.theme-bg {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.theme-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.8s var(--ease-luxury);\n}\n\n.theme-card:hover .theme-img {\n  transform: scale(1.08);\n}\n\n.theme-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(4, 15, 11, 0.95) 0%, rgba(4, 15, 11, 0.4) 60%, transparent 100%);\n  z-index: 1;\n}\n\n.theme-content {\n  position: relative;\n  z-index: 2;\n}\n\n.theme-count {\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n  margin-bottom: 0.35rem;\n}\n\n.theme-title {\n  font-family: var(--font-serif);\n  font-size: 1.4rem;\n  color: var(--text-pure);\n  margin-bottom: 0.35rem;\n}\n\n.theme-sub {\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  line-height: 1.4;\n}\n\n/* --------------------------------------------------------------------------\n   FULL-SCREEN IMMERSIVE DESTINATION DETAILS MODAL\n   -------------------------------------------------------------------------- */\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 9999;\n  background: rgba(3, 12, 9, 0.88);\n  backdrop-filter: blur(25px);\n  -webkit-backdrop-filter: blur(25px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity 0.5s var(--ease-luxury), visibility 0.5s;\n  padding: 1.5rem;\n}\n\n.modal-backdrop.open {\n  opacity: 1;\n  visibility: visible;\n}\n\n.destination-modal {\n  position: relative;\n  width: 100%;\n  max-width: 1060px;\n  max-height: 90vh;\n  background: #071F17;\n  border: 1px solid var(--glass-border-gold);\n  border-radius: var(--radius-lg);\n  overflow-y: auto;\n  overflow-x: hidden;\n  box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.8);\n  transform: translateY(30px) scale(0.96);\n  transition: transform 0.5s var(--ease-luxury);\n}\n\n.modal-backdrop.open .destination-modal {\n  transform: translateY(0) scale(1);\n}\n\n.modal-close-btn {\n  position: absolute;\n  top: 1.5rem;\n  right: 1.5rem;\n  z-index: 20;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: rgba(0, 0, 0, 0.5);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  color: var(--text-pure);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all var(--transition-fast);\n}\n\n.modal-close-btn:hover {\n  background: var(--gold-prime);\n  border-color: var(--gold-prime);\n  color: #061A13;\n  transform: rotate(90deg);\n}\n\n/* Modal Hero Header */\n.modal-hero {\n  position: relative;\n  height: 380px;\n  width: 100%;\n  overflow: hidden;\n}\n\n.modal-hero-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  animation: modal-img-reveal 0.8s var(--ease-luxury);\n}\n\n@keyframes modal-img-reveal {\n  0% { transform: scale(1.1); filter: blur(8px); }\n  100% { transform: scale(1); filter: blur(0); }\n}\n\n.modal-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    to bottom,\n    rgba(7, 31, 23, 0.2) 0%,\n    rgba(7, 31, 23, 0.6) 50%,\n    rgba(7, 31, 23, 1) 100%\n  );\n}\n\n.modal-hero-text {\n  position: absolute;\n  bottom: 2rem;\n  left: 2.5rem;\n  right: 2.5rem;\n  z-index: 2;\n}\n\n.modal-badge-row {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.modal-title {\n  font-size: clamp(2rem, 4vw, 3rem);\n  color: var(--text-pure);\n  margin-bottom: 0.35rem;\n}\n\n.modal-tagline {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-light);\n  font-size: 1.15rem;\n}\n\n/* Modal Body Content */\n.modal-body {\n  padding: 2.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 2.5rem;\n}\n\n.modal-grid-layout {\n  display: grid;\n  grid-template-columns: 2fr 1fr;\n  gap: 2.5rem;\n}\n\n.modal-main-desc {\n  font-size: 1.05rem;\n  line-height: 1.7;\n  color: var(--text-main);\n  margin-bottom: 1.75rem;\n}\n\n.modal-section-title {\n  font-size: 1.25rem;\n  font-family: var(--font-serif);\n  color: var(--text-pure);\n  margin-bottom: 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.modal-highlights-list {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.modal-highlight-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  font-size: 0.95rem;\n  color: var(--text-main);\n}\n\n.modal-highlight-item svg {\n  color: var(--gold-prime);\n  flex-shrink: 0;\n  margin-top: 3px;\n}\n\n/* Quick Facts Sidebar Card */\n.modal-sidebar-card {\n  background: rgba(11, 36, 27, 0.5);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: var(--radius-md);\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.modal-info-row {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  padding-bottom: 0.85rem;\n}\n\n.modal-info-row:last-child {\n  border-bottom: none;\n  padding-bottom: 0;\n}\n\n.info-label {\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n}\n\n.info-val {\n  font-size: 0.92rem;\n  color: var(--text-pure);\n}\n\n/* ==========================================================================\n   SAFETY INFORMATION CARDS (PRECAUTION & MAJOR WARNING)\n   ========================================================================== */\n.safety-cards-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.5rem;\n}\n\n/* Precaution Card */\n.safety-card-precaution {\n  background: var(--precaution-bg);\n  border: 1px solid var(--precaution-border);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.safety-header {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--precaution-green);\n}\n\n.safety-body {\n  font-size: 0.92rem;\n  color: #D5F5EE;\n  line-height: 1.5;\n}\n\n/* Major Safety Warning Card */\n.safety-card-warning {\n  background: var(--warning-bg);\n  border: 1px solid var(--warning-border);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.safety-card-warning .safety-header {\n  color: var(--warning-amber);\n}\n\n.safety-card-warning .safety-body {\n  font-size: 0.92rem;\n  color: #FEF3C7;\n  line-height: 1.5;\n}\n\n/* Transit & How to Reach Section */\n.transit-box {\n  background: rgba(11, 36, 27, 0.4);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n}\n\n.transit-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.5rem;\n}\n\n.transit-item {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.transit-title {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--gold-light);\n}\n\n.transit-desc {\n  font-size: 0.88rem;\n  color: var(--text-muted);\n}\n\n/* Modal Actions Footer */\n.modal-footer-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  padding-top: 1.75rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.coordinates-pill {\n  font-family: monospace;\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  background: rgba(0, 0, 0, 0.3);\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-sm);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n/* --------------------------------------------------------------------------\n   FOOTER (EDITORIAL LUXURY)\n   -------------------------------------------------------------------------- */\n.footer {\n  background: #030E09;\n  border-top: 1px solid var(--glass-border);\n  padding: 6rem 0 3rem;\n  position: relative;\n}\n\n.footer-grid {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr 1.5fr;\n  gap: 3.5rem;\n  margin-bottom: 4.5rem;\n}\n\n.footer-brand-desc {\n  font-size: 0.95rem;\n  color: var(--text-muted);\n  max-width: 320px;\n  margin-top: 1rem;\n  line-height: 1.6;\n}\n\n.footer-tagline {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-light);\n  margin-top: 0.75rem;\n}\n\n.footer-col-title {\n  font-family: var(--font-serif);\n  font-size: 1.15rem;\n  color: var(--text-pure);\n  margin-bottom: 1.25rem;\n}\n\n.footer-links {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.footer-link {\n  font-size: 0.9rem;\n  color: var(--text-muted);\n  transition: color var(--transition-fast), transform var(--transition-fast);\n  display: inline-block;\n}\n\n.footer-link:hover {\n  color: var(--gold-prime);\n  transform: translateX(4px);\n}\n\n.footer-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  padding-top: 2rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--text-muted);\n  font-size: 0.85rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.made-for-explorers {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-prime);\n}\n\n/* --------------------------------------------------------------------------\n   ANIMATIONS & SCROLL REVEALS\n   -------------------------------------------------------------------------- */\n.fade-up {\n  opacity: 0;\n  transform: translateY(35px);\n  transition: opacity 0.8s var(--ease-luxury), transform 0.8s var(--ease-luxury);\n  will-change: opacity, transform;\n}\n\n.fade-up.in-view {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Delay helpers */\n.delay-1 { transition-delay: 0.1s; }\n.delay-2 { transition-delay: 0.2s; }\n.delay-3 { transition-delay: 0.3s; }\n.delay-4 { transition-delay: 0.4s; }\n\n/* --------------------------------------------------------------------------\n   RESPONSIVE DESIGN (MOBILE & TABLET UX)\n   -------------------------------------------------------------------------- */\n@media (max-width: 1024px) {\n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .modal-grid-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .nav-links,\n  .audio-toggle-btn {\n    display: none;\n  }\n\n  .mobile-nav-toggle {\n    display: flex;\n  }\n\n  .destinations-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .stats-item {\n    border-left: none;\n    border-bottom: 1px solid rgba(197, 160, 89, 0.2);\n    padding-left: 0;\n    padding-bottom: 1.25rem;\n  }\n\n  .safety-cards-container {\n    grid-template-columns: 1fr;\n  }\n\n  .transit-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .map-wrapper {\n    height: 480px;\n  }\n\n  .modal-hero {\n    height: 260px;\n  }\n\n  .modal-body {\n    padding: 1.5rem;\n  }\n\n  .destination-card {\n    height: 440px;\n  }\n\n  .card-cursor-follower {\n    display: none !important;\n  }\n}\n\n/* --------------------------------------------------------------------------\n   ACCESSIBILITY & PREFERS-REDUCED-MOTION\n   -------------------------------------------------------------------------- */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n\n  .hero-bg-image,\n  .hero-orb {\n    animation: none !important;\n  }\n\n  .fade-up {\n    opacity: 1 !important;\n    transform: none !important;\n  }\n}\n","Description":"Update main.css with scroll progress bar, specular sheen, 3D tilt styles, and glowing orbs","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\css\\main.css","toolAction":"Updating main.css","toolSummary":"Updating main.css"}}]}
