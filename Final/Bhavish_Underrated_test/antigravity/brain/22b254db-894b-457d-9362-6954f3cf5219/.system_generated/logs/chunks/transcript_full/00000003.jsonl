{"step_index":59,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-22T11:31:49Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/* ==========================================================================\n   JHARKHAND TOURISM - CUSTOM LEAFLET MAP & MARKER STYLES\n   ========================================================================== */\n\n/* Leaflet Container Styling */\n.leaflet-container {\n  background-color: #061A13 !important;\n  font-family: 'Plus Jakarta Sans', sans-serif !important;\n}\n\n/* Custom Carto Tile filter for deep luxury forest tone */\n.leaflet-tile-pane {\n  filter: brightness(0.8) contrast(1.15) saturate(1.1) hue-rotate(-15deg);\n}\n\n/* Custom Marker Pin Styling */\n.custom-map-marker {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n.custom-map-marker:hover {\n  transform: scale(1.25) translateY(-6px);\n  z-index: 1000 !important;\n}\n\n.marker-pin {\n  width: 38px;\n  height: 38px;\n  border-radius: 50% 50% 50% 0;\n  transform: rotate(-45deg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);\n  position: relative;\n  background: linear-gradient(135deg, #DFC27D 0%, #C5A059 100%);\n  border: 2px solid #FFFFFF;\n}\n\n.marker-icon-inner {\n  transform: rotate(45deg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #061A13;\n}\n\n.marker-icon-inner svg {\n  width: 18px;\n  height: 18px;\n}\n\n/* Radiant Gold Pulsing Beacon Ring */\n.custom-map-marker::after {\n  content: '';\n  position: absolute;\n  bottom: -4px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 18px;\n  height: 18px;\n  border-radius: 50%;\n  background: rgba(197, 160, 89, 0.5);\n  animation: pulse-ring 2.4s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;\n  z-index: -1;\n}\n\n@keyframes pulse-ring {\n  0% {\n    transform: translateX(-50%) scale(0.6);\n    opacity: 0.9;\n  }\n  100% {\n    transform: translateX(-50%) scale(2.8);\n    opacity: 0;\n  }\n}\n\n/* --------------------------------------------------------------------------\n   CUSTOM LEAFLET POPUP CARD\n   -------------------------------------------------------------------------- */\n.leaflet-popup-content-wrapper {\n  background: rgba(7, 31, 23, 0.95) !important;\n  backdrop-filter: blur(20px) !important;\n  -webkit-backdrop-filter: blur(20px) !important;\n  border: 1px solid rgba(197, 160, 89, 0.35) !important;\n  border-radius: 14px !important;\n  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.85) !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n  color: #EDE8DE !important;\n}\n\n.leaflet-popup-content {\n  margin: 0 !important;\n  line-height: 1.4 !important;\n  width: 280px !important;\n}\n\n.leaflet-popup-tip {\n  background: rgba(7, 31, 23, 0.95) !important;\n  border: 1px solid rgba(197, 160, 89, 0.35) !important;\n}\n\n.leaflet-container a.leaflet-popup-close-button {\n  top: 10px !important;\n  right: 10px !important;\n  color: #FFFFFF !important;\n  background: rgba(0, 0, 0, 0.6) !important;\n  border-radius: 50% !important;\n  width: 26px !important;\n  height: 26px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  border: 1px solid rgba(255, 255, 255, 0.2) !important;\n  font-size: 14px !important;\n  transition: all 0.2s ease !important;\n  z-index: 10 !important;\n}\n\n.leaflet-container a.leaflet-popup-close-button:hover {\n  background: #C5A059 !important;\n  color: #061A13 !important;\n  border-color: #C5A059 !important;\n  transform: rotate(90deg);\n}\n\n/* Inside Popup Structure */\n.map-popup-card {\n  display: flex;\n  flex-direction: column;\n}\n\n.map-popup-thumb-wrap {\n  position: relative;\n  width: 100%;\n  height: 140px;\n  overflow: hidden;\n}\n\n.map-popup-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s ease;\n}\n\n.map-popup-card:hover .map-popup-img {\n  transform: scale(1.05);\n}\n\n.map-popup-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(7, 31, 23, 0.95) 0%, transparent 60%);\n}\n\n.map-popup-type-badge {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  padding: 3px 9px;\n  border-radius: 9999px;\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  background: rgba(0, 0, 0, 0.6);\n  backdrop-filter: blur(8px);\n  color: #DFC27D;\n  border: 1px solid rgba(197, 160, 89, 0.5);\n}\n\n.map-popup-info {\n  padding: 14px 16px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.map-popup-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.15rem;\n  font-weight: 500;\n  color: #FFFFFF;\n  line-height: 1.2;\n}\n\n.map-popup-meta {\n  font-size: 0.75rem;\n  color: #A3B8B0;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.map-popup-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 8px;\n  padding-top: 8px;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  font-size: 0.75rem;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #DFC27D;\n  cursor: pointer;\n  transition: color 0.2s ease;\n}\n\n.map-popup-cta:hover {\n  color: #FFFFFF;\n}\n\n/* Custom Zoom Controls */\n.leaflet-bar {\n  border: 1px solid rgba(255, 255, 255, 0.15) !important;\n  border-radius: 8px !important;\n  overflow: hidden !important;\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;\n}\n\n.leaflet-bar a {\n  background-color: rgba(7, 31, 23, 0.9) !important;\n  color: #EDE8DE !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;\n  transition: background 0.2s ease, color 0.2s ease !important;\n}\n\n.leaflet-bar a:hover {\n  background-color: #C5A059 !important;\n  color: #061A13 !important;\n}\n","Description":"Update map.css with radiant gold pulse markers and custom card popups","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\css\\map.css","toolAction":"Updating map.css","toolSummary":"Updating map.css"}}]}
