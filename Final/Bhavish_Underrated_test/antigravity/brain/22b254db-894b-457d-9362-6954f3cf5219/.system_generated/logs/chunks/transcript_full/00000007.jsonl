 0.25);\n  overflow-y: auto;\n  padding: 2.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n  transform: scale(0.94);\n  transition: transform 0.5s var(--ease-spring);\n}\n\n.passport-modal-backdrop.open .passport-book {\n  transform: scale(1);\n}\n\n.passport-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 1px solid rgba(197, 160, 89, 0.3);\n  padding-bottom: 1.5rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.passport-title-wrap {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.passport-emblem {\n  width: 54px;\n  height: 54px;\n  border-radius: 50%;\n  border: 2px solid var(--gold-prime);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.8rem;\n  background: rgba(197, 160, 89, 0.15);\n  box-shadow: 0 0 20px rgba(197, 160, 89, 0.3);\n}\n\n.passport-rank-badge {\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n}\n\n.passport-user-rank {\n  font-family: var(--font-serif);\n  font-size: 1.8rem;\n  color: var(--text-pure);\n}\n\n.passport-progress-summary {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.passport-level-pill {\n  background: rgba(197, 160, 89, 0.15);\n  border: 1px solid var(--gold-prime);\n  padding: 0.5rem 1.25rem;\n  border-radius: var(--radius-full);\n  color: var(--gold-light);\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n/* 5 Stamps Grid Layout */\n.passport-stamps-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 1.5rem;\n}\n\n.passport-stamp-slot {\n  position: relative;\n  height: 240px;\n  border-radius: var(--radius-md);\n  border: 1.5px dashed rgba(197, 160, 89, 0.35);\n  background: rgba(4, 15, 11, 0.6);\n  padding: 1.25rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  transition: all 0.4s var(--ease-luxury);\n  overflow: hidden;\n}\n\n.passport-stamp-slot.unlocked {\n  border-style: solid;\n  border-color: var(--gold-prime);\n  background: rgba(11, 36, 27, 0.8);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(197, 160, 89, 0.15);\n}\n\n.stamp-seal-badge {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  padding: 2px 8px;\n  border-radius: var(--radius-full);\n  background: rgba(16, 185, 129, 0.3);\n  border: 1px solid #10B981;\n  color: #34D399;\n}\n\n.stamp-thumbnail-mini {\n  width: 76px;\n  height: 76px;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 2px solid var(--gold-prime);\n  margin-bottom: 0.75rem;\n  box-shadow: 0 0 15px rgba(197, 160, 89, 0.3);\n}\n\n.stamp-locked-icon {\n  font-size: 2.5rem;\n  opacity: 0.35;\n  margin-bottom: 0.5rem;\n}\n\n.stamp-place-name {\n  font-family: var(--font-serif);\n  font-size: 1.05rem;\n  color: var(--text-pure);\n  line-height: 1.2;\n  margin-bottom: 4px;\n}\n\n.stamp-clue {\n  font-size: 0.75rem;\n  color: var(--text-muted);\n  line-height: 1.35;\n}\n\n.passport-footer-actions {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-top: 1px solid rgba(197, 160, 89, 0.2);\n  padding-top: 1.5rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n/* --------------------------------------------------------------------------\n   FULL-SCREEN IMMERSIVE DESTINATION DETAILS MODAL\n   -------------------------------------------------------------------------- */\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 9999;\n  background: rgba(3, 12, 9, 0.88);\n  backdrop-filter: blur(25px);\n  -webkit-backdrop-filter: blur(25px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity 0.5s var(--ease-luxury), visibility 0.5s;\n  padding: 1.5rem;\n}\n\n.modal-backdrop.open {\n  opacity: 1;\n  visibility: visible;\n}\n\n.destination-modal {\n  position: relative;\n  width: 100%;\n  max-width: 1060px;\n  max-height: 90vh;\n  background: #071F17;\n  border: 1px solid var(--glass-border-gold);\n  border-radius: var(--radius-lg);\n  overflow-y: auto;\n  overflow-x: hidden;\n  box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.8);\n  transform: translateY(30px) scale(0.96);\n  transition: transform 0.5s var(--ease-luxury);\n}\n\n.modal-backdrop.open .destination-modal {\n  transform: translateY(0) scale(1);\n}\n\n.modal-close-btn {\n  position: absolute;\n  top: 1.5rem;\n  right: 1.5rem;\n  z-index: 20;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: rgba(0, 0, 0, 0.5);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  color: var(--text-pure);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all var(--transition-fast);\n}\n\n.modal-close-btn:hover {\n  background: var(--gold-prime);\n  border-color: var(--gold-prime);\n  color: #061A13;\n  transform: rotate(90deg);\n}\n\n.modal-hero {\n  position: relative;\n  height: 380px;\n  width: 100%;\n  overflow: hidden;\n}\n\n.modal-hero-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  animation: modal-img-reveal 0.8s var(--ease-luxury);\n}\n\n@keyframes modal-img-reveal {\n  0% { transform: scale(1.1); filter: blur(8px); }\n  100% { transform: scale(1); filter: blur(0); }\n}\n\n.modal-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    to bottom,\n    rgba(7, 31, 23, 0.2) 0%,\n    rgba(7, 31, 23, 0.6) 50%,\n    rgba(7, 31, 23, 1) 100%\n  );\n}\n\n.modal-hero-text {\n  position: absolute;\n  bottom: 2rem;\n  left: 2.5rem;\n  right: 2.5rem;\n  z-index: 2;\n}\n\n.modal-badge-row {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.modal-title {\n  font-size: clamp(2rem, 4vw, 3rem);\n  color: var(--text-pure);\n  margin-bottom: 0.35rem;\n}\n\n.modal-tagline {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-light);\n  font-size: 1.15rem;\n}\n\n.modal-body {\n  padding: 2.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 2.5rem;\n}\n\n.modal-grid-layout {\n  display: grid;\n  grid-template-columns: 2fr 1fr;\n  gap: 2.5rem;\n}\n\n.modal-main-desc {\n  font-size: 1.05rem;\n  line-height: 1.7;\n  color: var(--text-main);\n  margin-bottom: 1.75rem;\n}\n\n.modal-section-title {\n  font-size: 1.25rem;\n  font-family: var(--font-serif);\n  color: var(--text-pure);\n  margin-bottom: 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.modal-highlights-list {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.modal-highlight-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  font-size: 0.95rem;\n  color: var(--text-main);\n}\n\n.modal-highlight-item svg {\n  color: var(--gold-prime);\n  flex-shrink: 0;\n  margin-top: 3px;\n}\n\n.modal-sidebar-card {\n  background: rgba(11, 36, 27, 0.5);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: var(--radius-md);\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.modal-info-row {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  padding-bottom: 0.85rem;\n}\n\n.modal-info-row:last-child {\n  border-bottom: none;\n  padding-bottom: 0;\n}\n\n.info-label {\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--gold-prime);\n}\n\n.info-val {\n  font-size: 0.92rem;\n  color: var(--text-pure);\n}\n\n/* Safety Information */\n.safety-cards-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.5rem;\n}\n\n.safety-card-precaution {\n  background: var(--precaution-bg);\n  border: 1px solid var(--precaution-border);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.safety-header {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--precaution-green);\n}\n\n.safety-body {\n  font-size: 0.92rem;\n  color: #D5F5EE;\n  line-height: 1.5;\n}\n\n.safety-card-warning {\n  background: var(--warning-bg);\n  border: 1px solid var(--warning-border);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.safety-card-warning .safety-header {\n  color: var(--warning-amber);\n}\n\n.safety-card-warning .safety-body {\n  font-size: 0.92rem;\n  color: #FEF3C7;\n  line-height: 1.5;\n}\n\n.transit-box {\n  background: rgba(11, 36, 27, 0.4);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n}\n\n.transit-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.5rem;\n}\n\n.transit-item {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.transit-title {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--gold-light);\n}\n\n.transit-desc {\n  font-size: 0.88rem;\n  color: var(--text-muted);\n}\n\n.modal-footer-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  padding-top: 1.75rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.coordinates-pill {\n  font-family: monospace;\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  background: rgba(0, 0, 0, 0.3);\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-sm);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n/* --------------------------------------------------------------------------\n   FOOTER (EDITORIAL LUXURY)\n   -------------------------------------------------------------------------- */\n.footer {\n  background: #030E09;\n  border-top: 1px solid var(--glass-border);\n  padding: 6rem 0 3rem;\n  position: relative;\n}\n\n.footer-grid {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr 1.5fr;\n  gap: 3.5rem;\n  margin-bottom: 4.5rem;\n}\n\n.footer-brand-desc {\n  font-size: 0.95rem;\n  color: var(--text-muted);\n  max-width: 320px;\n  margin-top: 1rem;\n  line-height: 1.6;\n}\n\n.footer-tagline {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-light);\n  margin-top: 0.75rem;\n}\n\n.footer-col-title {\n  font-family: var(--font-serif);\n  font-size: 1.15rem;\n  color: var(--text-pure);\n  margin-bottom: 1.25rem;\n}\n\n.footer-links {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.footer-link {\n  font-size: 0.9rem;\n  color: var(--text-muted);\n  transition: color var(--transition-fast), transform var(--transition-fast);\n  display: inline-block;\n}\n\n.footer-link:hover {\n  color: var(--gold-prime);\n  transform: translateX(4px);\n}\n\n.footer-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  padding-top: 2rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--text-muted);\n  font-size: 0.85rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.made-for-explorers {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--gold-prime);\n}\n\n/* --------------------------------------------------------------------------\n   ANIMATIONS & SCROLL REVEALS\n   -------------------------------------------------------------------------- */\n.fade-up {\n  opacity: 0;\n  transform: translateY(35px);\n  transition: opacity 0.8s var(--ease-luxury), transform 0.8s var(--ease-luxury);\n  will-change: opacity, transform;\n}\n\n.fade-up.in-view {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.delay-1 { transition-delay: 0.1s; }\n.delay-2 { transition-delay: 0.2s; }\n.delay-3 { transition-delay: 0.3s; }\n.delay-4 { transition-delay: 0.4s; }\n\n/* --------------------------------------------------------------------------\n   RESPONSIVE DESIGN\n   -------------------------------------------------------------------------- */\n@media (max-width: 1024px) {\n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .modal-grid-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .nav-links {\n    display: none;\n  }\n\n  .mobile-nav-toggle {\n    display: flex;\n  }\n\n  .destinations-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .safety-cards-container {\n    grid-template-columns: 1fr;\n  }\n\n  .transit-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .map-wrapper {\n    height: 480px;\n  }\n\n  .modal-hero {\n    height: 260px;\n  }\n\n  .modal-body {\n    padding: 1.5rem;\n  }\n\n  .destination-card {\n    height: 440px;\n  }\n\n  .card-cursor-follower {\n    display: none !important;\n  }\n\n  .unlock-toast {\n    right: 1rem;\n    left: 1rem;\n    top: 80px;\n    max-width: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n\n  .hero-bg-image,\n  .hero-orb {\n    animation: none !important;\n  }\n\n  .fade-up {\n    opacity: 1 !important;\n    transform: none !important;\n  }\n}\n","Description":"Update main.css with crazy vault unlock gateway portal, laser rings, and 5-stamp passport layout","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\css\\main.css","toolAction":"Updating main.css","toolSummary":"Updating main.css"}}]}
