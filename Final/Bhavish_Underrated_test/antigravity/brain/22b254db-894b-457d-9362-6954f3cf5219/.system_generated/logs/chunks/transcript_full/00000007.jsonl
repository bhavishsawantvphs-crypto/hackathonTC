{"step_index":149,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-22T11:53:42Z","content":"Created At: 2026-08-22T17:23:42+05:30\nCompleted At: 2026-08-22T17:23:43+05:30\nFile Path: `file:///C:/Users/Bhavish%20Sawant/.gemini/antigravity/scratch/jharkhand-tourism/js/map.js`\nTotal Lines: 222\nTotal Bytes: 6877\nShowing lines 1 to 222\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * Jharkhand Tourism - Interactive Map Controller\n3:  * Leaflet.js integration with custom markers, smooth flyTo camera, and filtering.\n4:  * Focus: FAMOUS DESTINATIONS OF JHARKHAND\n5:  */\n6: \n7: let jharkhandMap = null;\n8: let mapMarkers = [];\n9: let markerLayerGroup = null;\n10: \n11: // Default Geographic Center of Jharkhand\n12: const JHARKHAND_CENTER = {\n13:   lat: 23.6102,\n14:   lng: 85.2799,\n15:   defaultZoom: 8,\n16:   focusZoom: 12\n17: };\n18: \n19: /**\n20:  * Initialize the Leaflet Map with CartoDB Dark Matter / Voyager tiles\n21:  */\n22: function initJharkhandMap() {\n23:   const mapElement = document.getElementById(\"jharkhand-map\");\n24:   if (!mapElement) return;\n25: \n26:   // Initialize Map\n27:   jharkhandMap = L.map(\"jharkhand-map\", {\n28:     center: [JHARKHAND_CENTER.lat, JHARKHAND_CENTER.lng],\n29:     zoom: JHARKHAND_CENTER.defaultZoom,\n30:     minZoom: 6,\n31:     maxZoom: 17,\n32:     zoomControl: true,\n33:     scrollWheelZoom: false\n34:   });\n35: \n36:   // Enable scroll zoom on focus\n37:   jharkhandMap.on(\"focus\", () => jharkhandMap.scrollWheelZoom.enable());\n38:   jharkhandMap.on(\"blur\", () => jharkhandMap.scrollWheelZoom.disable());\n39: \n40:   // Base Map Layer (CartoDB Voyager)\n41:   L.tileLayer(\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\", {\n42:     attribution: '&copy; <a href=\"https://carto.com/\">CARTO</a> | &copy; Jharkhand Tourism',\n43:     subdomains: \"abcd\",\n44:     maxZoom: 19\n45:   }).addTo(jharkhandMap);\n46: \n47:   markerLayerGroup = L.layerGroup().addTo(jharkhandMap);\n48: \n49:   // Render Famous Markers\n50:   renderMapMarkers(FAMOUS_DESTINATIONS);\n51: \n52:   // Map Filter Buttons Event Listener\n53:   setupMapFilterEvents();\n54: }\n55: \n56: /**\n57:  * Render custom SVG markers onto the map\n58:  * @param {Array} destinations\n59:  */\n60: function renderMapMarkers(destinations) {\n61:   if (!markerLayerGroup) return;\n62:   markerLayerGroup.clearLayers();\n63:   mapMarkers = [];\n64: \n65:   destinations.forEach((dest) => {\n66:     // Custom Icon SVG markup\n67:     const customIconHtml = `\n68:       <div class=\"custom-map-marker\">\n69:         <div class=\"marker-pin\">\n70:           <div class=\"marker-icon-inner\">\n71:             <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n72:               <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n73:               <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n74:             </svg>\n75:           </div>\n76:         </div>\n77:       </div>\n78:     `;\n79: \n80:     const customIcon = L.divIcon({\n81:       html: customIconHtml,\n82:       className: \"custom-leaflet-div-icon\",\n83:       iconSize: [40, 40],\n84:       iconAnchor: [20, 38],\n85:       popupAnchor: [0, -40]\n86:     });\n87: \n88:     // Marker Popup HTML\n89:     const popupContent = `\n90:       <div class=\"map-popup-card\">\n91:         <div class=\"map-popup-thumb-wrap\">\n92:           <img src=\"${dest.thumbnail}\" alt=\"${dest.name}\" class=\"map-popup-img\" loading=\"lazy\" />\n93:           <div class=\"map-popup-overlay\"></div>\n94:           <span class=\"map-popup-type-badge\">Famous Place</span>\n95:         </div>\n96:         <div class=\"map-popup-info\">\n97:           <h4 class=\"map-popup-title\">${dest.name}</h4>\n98:           <div class=\"map-popup-meta\">\n99:             <span>${dest.category}</span> • <span>${dest.district}</span>\n100:           </div>\n101:           <div class=\"map-popup-cta\" onclick=\"openDestinationModal('${dest.id}')\">\n102:             <span>Explore Details</span>\n103:             <span>→</span>\n104:           </div>\n105:         </div>\n106:       </div>\n107:     `;\n108: \n109:     const marker = L.marker([dest.coordinates.lat, dest.coordinates.lng], {\n110:       icon: customIcon,\n111:       title: dest.name\n112:     }).bindPopup(popupContent);\n113: \n114:     marker.destinationId = dest.id;\n115:     marker.destinationData = dest;\n116: \n117:     markerLayerGroup.addLayer(marker);\n118:     mapMarkers.push(marker);\n119:   });\n120: }\n121: \n122: /**\n123:  * Focus and smooth fly-to on a specific destination\n124:  * @param {string} destinationId\n125:  */\n126: function focusDestinationOnMap(destinationId) {\n127:   const destination = FAMOUS_DESTINATIONS.find((d) => d.id === destinationId);\n128:   if (!destination || !jharkhandMap) return;\n129: \n130:   // Scroll to Map Section smoothly\n131:   const mapSection = document.getElementById(\"map-section\");\n132:   if (mapSection) {\n133:     mapSection.scrollIntoView({ behavior: \"smooth\", block: \"center\" });\n134:   }\n135: \n136:   // Smooth camera flyTo\n137:   setTimeout(() => {\n138:     jharkhandMap.flyTo(\n139:       [destination.coordinates.lat, destination.coordinates.lng],\n140:       JHARKHAND_CENTER.focusZoom,\n141:       {\n142:         duration: 1.4,\n143:         easeLinearity: 0.25\n144:       }\n145:     );\n146: \n147:     // Open matching marker popup\n148:     const targetMarker = mapMarkers.find((m) => m.destinationId === destinationId);\n149:     if (targetMarker) {\n150:       setTimeout(() => targetMarker.openPopup(), 1200);\n151:     }\n152:   }, 350);\n153: }\n154: \n155: /**\n156:  * Reset map view back to entire Jharkhand overview\n157:  */\n158: function resetJharkhandMapView() {\n159:   if (!jharkhandMap) return;\n160:   jharkhandMap.closePopup();\n161:   jharkhandMap.flyTo(\n162:     [JHARKHAND_CENTER.lat, JHARKHAND_CENTER.lng],\n163:     JHARKHAND_CENTER.defaultZoom,\n164:     {\n165:       duration: 1.2\n166:     }\n167:   );\n168: }\n169: \n170: /**\n171:  * Setup filter chip event listeners on the map\n172:  */\n173: function setupMapFilterEvents() {\n174:   const filterButtons = document.querySelectorAll(\".map-filter-btn\");\n175:   filterButtons.forEach((btn) => {\n176:     btn.addEventListener(\"click\", () => {\n177:       filterButtons.forEach((b) => b.classList.remove(\"active\"));\n178:       btn.classList.add(\"active\");\n179: \n180:       const filterType = btn.dataset.filter.toLowerCase();\n181:       if (filterType === \"all\") {\n182:         renderMapMarkers(FAMOUS_DESTINATIONS);\n183:       } else if (filterType === \"waterfalls\") {\n184:         const filtered = FAMOUS_DESTINATIONS.filter((d) =>\n185:           d.category.toLowerCase().includes(\"waterfall\")\n186:         );\n187:         renderMapMarkers(filtered);\n188:       } else if (filterType === \"wildlife\") {\n189:         const filtered = FAMOUS_DESTINATIONS.filter((d) =>\n190:           d.category.toLowerCase().includes(\"wildlife\") || d.category.toLowerCase().includes(\"nature\")\n191:         );\n192:         renderMapMarkers(filtered);\n193:       } else if (filterType === \"spiritual\") {\n194:         const filtered = FAMOUS_DESTINATIONS.filter((d) =>\n195:           d.category.toLowerCase().includes(\"spiritual\") || d.category.toLowerCase().includes(\"heritage\")\n196:         );\n197:         renderMapMarkers(filtered);\n198:       } else if (filterType === \"scenic\") {\n199:         const filtered = FAMOUS_DESTINATIONS.filter((d) =>\n200:           d.category.toLowerCase().includes(\"scenic\") || d.category.toLowerCase().includes(\"lake\") || d.category.toLowerCase().includes(\"mountain\")\n201:         );\n202:         renderMapMarkers(filtered);\n203:       }\n204:     });\n205:   });\n206: \n207:   const resetBtn = document.querySelector(\".map-reset-btn\");\n208:   if (resetBtn) {\n209:     resetBtn.addEventListener(\"click\", () => {\n210:       filterButtons.forEach((b) => b.classList.remove(\"active\"));\n211:       document.querySelector('.map-filter-btn[data-filter=\"all\"]')?.classList.add(\"active\");\n212:       renderMapMarkers(FAMOUS_DESTINATIONS);\n213:       resetJharkhandMapView();\n214:     });\n215:   }\n216: }\n217: \n218: // Export functions to global scope\n219: window.initJharkhandMap = initJharkhandMap;\n220: window.focusDestinationOnMap = focusDestinationOnMap;\n221: window.resetJharkhandMapView = resetJharkhandMapView;\n222: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":150,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-22T11:53:43Z","thinking":"**Checking Famous Destinations**\n\nI've confirmed that `js/map.js` seamlessly integrates with `FAMOUS_DESTINATIONS`, which now accurately reflects the top 5 famous places. Next, I'll turn my attention to `js/app.js`, where I plan to implement the unlock gateway animation handler, the 5-stamp passport controller, and a confetti effect. I want to build these features carefully.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/**\n * Jharkhand Tourism - Official Application Logic\n * Crazy Cinematic Expedition Vault Gateway Unlock, 5 Collectible Stamps Passport & 3D Tilt\n * Focus: TOP 5 FAMOUS DESTINATIONS & IMMERSIVE TOURIST EXPEDITION\n */\n\n// Global State for Explorer Passport\nlet unlockedDestinations = [];\nlet totalScoreXP = 0;\nlet isSiteUnlocked = false;\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  // 1. Load unlocked state from localStorage\n  loadPassportProgress();\n\n  // 2. Initialize the Crazy Cinematic Vault Gateway Unlock\n  initExpeditionVaultGateway();\n\n  // 3. Initialize Navigation & Reading Progress\n  initNavigation();\n  initScrollProgressBar();\n\n  // 4. Render 5 Famous Destinations\n  renderFamousDestinations();\n  renderDidYouKnowFacts();\n  renderTravelThemes();\n\n  // 5. Initialize Category Filters\n  initCategoryFilters();\n\n  // 6. Initialize Desktop Custom Cursor & 3D Card Tilt\n  initCardCursorFollower();\n  initCard3DTilt();\n\n  // 7. Initialize Scroll Reveal Animations & Stat Counters\n  initScrollReveals();\n  initStatCounters();\n\n  // 8. Initialize Leaflet Map\n  if (typeof initJharkhandMap === \"function\") {\n    initJharkhandMap();\n  }\n\n  // 9. Initialize Confetti Canvas\n  initConfettiCanvas();\n\n  // 10. Update UI Passport Badges\n  updatePassportUI();\n});\n\n/* ==========================================================================\n   1. MAD FEATURE: CRAZY CINEMATIC EXPEDITION VAULT GATEWAY UNLOCK\n   ========================================================================== */\nfunction initExpeditionVaultGateway() {\n  const gateway = document.getElementById(\"expedition-vault-gateway\");\n  const sealBtn = document.getElementById(\"vault-seal-btn\");\n  if (!gateway || !sealBtn) return;\n\n  // Check if previously unlocked in this session\n  const alreadyUnlocked = sessionStorage.getItem(\"jharkhand_vault_unlocked\");\n  if (alreadyUnlocked === \"true\") {\n    gateway.classList.add(\"unlocked\");\n    isSiteUnlocked = true;\n    return;\n  }\n\n  // Unlock Trigger Click Handler\n  sealBtn.addEventListener(\"click\", () => {\n    performCrazyUnlock(gateway);\n  });\n\n  // Also unlock on Enter/Space keypress on the seal\n  sealBtn.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\" || e.key === \" \") {\n      e.preventDefault();\n      performCrazyUnlock(gateway);\n    }\n  });\n}\n\nfunction performCrazyUnlock(gateway) {\n  if (isSiteUnlocked) return;\n  isSiteUnlocked = true;\n\n  try {\n    sessionStorage.setItem(\"jharkhand_vault_unlocked\", \"true\");\n  } catch (e) {}\n\n  // 1. Huge Golden Shockwave Particle Storm\n  triggerEpicGatewayExplosion();\n\n  // 2. Cinematic Iris Shrink & Fade\n  gateway.style.transform = \"scale(1.05)\";\n  gateway.style.filter = \"brightness(2) contrast(1.5)\";\n\n  setTimeout(() => {\n    gateway.classList.add(\"unlocked\");\n  }, 350);\n\n  // 3. Show Initiation Toast\n  setTimeout(() => {\n    showInitiationUnlockToast();\n  }, 1000);\n}\n\nfunction triggerEpicGatewayExplosion() {\n  if (!confettiCtx) return;\n\n  const colors = [\"#C5A059\", \"#DFC27D\", \"#10B981\", \"#34D399\", \"#FFFFFF\", \"#F59E0B\", \"#FBBF24\"];\n  const particleCount = 160;\n\n  for (let i = 0; i < particleCount; i++) {\n    const angle = (Math.PI * 2 * i) / particleCount + (Math.random() - 0.5);\n    const speed = Math.random() * 22 + 6;\n\n    confettiParticles.push({\n      x: window.innerWidth / 2,\n      y: window.innerHeight / 2,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed,\n      size: Math.random() * 9 + 4,\n      color: colors[Math.floor(Math.random() * colors.length)],\n      rotation: Math.random() * 360,\n      rotationSpeed: (Math.random() - 0.5) * 16,\n      opacity: 1,\n      gravity: 0.28\n    });\n  }\n\n  animateConfetti();\n}\n\nfunction showInitiationUnlockToast() {\n  let toast = document.getElementById(\"unlock-toast\");\n  if (!toast) {\n    toast = document.createElement(\"div\");\n    toast.id = \"unlock-toast\";\n    toast.className = \"unlock-toast\";\n    document.body.appendChild(toast);\n  }\n\n  toast.innerHTML = `\n    <div class=\"unlock-toast-icon\">👑</div>\n    <div>\n      <div class=\"unlock-toast-title\">Expedition Vault Unlocked!</div>\n      <div class=\"unlock-toast-place\">Welcome to Jharkhand</div>\n      <div class=\"unlock-toast-xp\">Collect all 5 Famous Stamps in your Passport!</div>\n    </div>\n  `;\n\n  toast.classList.add(\"show\");\n\n  setTimeout(() => {\n    toast.classList.remove(\"show\");\n  }, 5000);\n}\n\n/* ==========================================================================\n   2. READING SCROLL PROGRESS BAR\n   ========================================================================== */\nfunction initScrollProgressBar() {\n  const progressBar = document.getElementById(\"scroll-progress-indicator\");\n  if (!progressBar) return;\n\n  window.addEventListener(\"scroll\", () => {\n    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;\n    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;\n    const scrolled = (winScroll / height) * 100;\n    progressBar.style.width = scrolled + \"%\";\n  }, { passive: true });\n}\n\n/* ==========================================================================\n   3. NAVIGATION CONTROLLER\n   ========================================================================== */\nfunction initNavigation() {\n  const navbar = document.getElementById(\"navbar\");\n  const mobileToggle = document.getElementById(\"mobile-nav-toggle\");\n  const mobileDrawer = document.getElementById(\"mobile-drawer\");\n  const navLinks = document.querySelectorAll(\".nav-link, .mobile-drawer-link\");\n\n  window.addEventListener(\"scroll\", () => {\n    const scrollY = window.scrollY;\n\n    if (scrollY > 50) {\n      navbar?.classList.add(\"scrolled\");\n    } else {\n      navbar?.classList.remove(\"scrolled\");\n    }\n\n    updateActiveNavLink();\n  }, { passive: true });\n\n  if (mobileToggle && mobileDrawer) {\n    mobileToggle.addEventListener(\"click\", () => {\n      const isOpen = mobileDrawer.classList.contains(\"open\");\n      if (isOpen) {\n        closeMobileDrawer();\n      } else {\n        openMobileDrawer();\n      }\n    });\n\n    navLinks.forEach((link) => {\n      link.addEventListener(\"click\", () => {\n        closeMobileDrawer();\n      });\n    });\n  }\n\n  function openMobileDrawer() {\n    mobileDrawer.classList.add(\"open\");\n    mobileToggle.classList.add(\"open\");\n    mobileToggle.setAttribute(\"aria-expanded\", \"true\");\n    document.body.style.overflow = \"hidden\";\n  }\n\n  function closeMobileDrawer() {\n    mobileDrawer.classList.remove(\"open\");\n    mobileToggle.classList.remove(\"open\");\n    mobileToggle.setAttribute(\"aria-expanded\", \"false\");\n    document.body.style.overflow = \"\";\n  }\n}\n\nfunction updateActiveNavLink() {\n  const sections = document.querySelectorAll(\"section[id]\");\n  const navLinks = document.querySelectorAll(\".nav-link\");\n  const scrollPosition = window.scrollY + 200;\n\n  sections.forEach((section) => {\n    const sectionTop = section.offsetTop;\n    const sectionHeight = section.offsetHeight;\n    const sectionId = section.getAttribute(\"id\");\n\n    if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {\n      navLinks.forEach((link) => {\n        if (link.getAttribute(\"href\") === `#${sectionId}`) {\n          link.classList.add(\"active\");\n        } else {\n          link.classList.remove(\"active\");\n        }\n      });\n    }\n  });\n}\n\n/* ==========================================================================\n   4. FAMOUS DESTINATION CARD CREATION & RENDERING (TOP 5)\n   ========================================================================== */\n\nfunction createFamousCardHtml(dest) {\n  const isUnlocked = unlockedDestinations.includes(dest.id);\n  const badgeHtml = isUnlocked\n    ? `<span class=\"badge-famous badge-unlocked\">🏆 Stamp Collected</span>`\n    : `<span class=\"badge-famous\">🔒 Explore to Unlock</span>`;\n\n  return `\n    <article class=\"destination-card fade-up ${isUnlocked ? 'is-unlocked' : ''}\" \n             data-category=\"${dest.category.toLowerCase()}\" \n             data-id=\"${dest.id}\" \n             onclick=\"openDestinationModal('${dest.id}')\" \n             tabindex=\"0\" \n             role=\"button\" \n             aria-label=\"Explore ${dest.name}\">\n      <div class=\"card-media\">\n        <img src=\"${dest.thumbnail}\" alt=\"${dest.name}\" class=\"card-img\" loading=\"lazy\" />\n        <div class=\"card-gradient\"></div>\n      </div>\n\n      <div class=\"card-top-meta\">\n        ${badgeHtml}\n        <span class=\"card-district\">${dest.district}</span>\n      </div>\n\n      <div class=\"card-body\">\n        <span class=\"card-category\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n          </svg>\n          ${dest.category}\n        </span>\n        <h3 class=\"card-title\">${dest.name}</h3>\n        <p class=\"card-tagline\">${dest.tagline}</p>\n        \n        <div class=\"card-cta-row\">\n          <span class=\"card-explore-btn\">\n            ${isUnlocked ? 'View Passport Stamp' : 'Explore & Collect Stamp'}\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n              <polyline points=\"12 5 19 12 12 19\"></polyline>\n            </svg>\n          </span>\n\n          <button class=\"card-map-action\" title=\"View on Map\" onclick=\"event.stopPropagation(); focusDestinationOnMap('${dest.id}');\" aria-label=\"View ${dest.name} on map\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n              <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </article>\n  `;\n}\n\nfunction renderFamousDestinations() {\n  const famousContainer = document.getElementById(\"famous-destinations-grid\");\n  if (!famousContainer || typeof FAMOUS_DESTINATIONS === \"undefined\") return;\n\n  famousContainer.innerHTML = FAMOUS_DESTINATIONS.map((d) => createFamousCardHtml(d)).join(\"\");\n\n  // Setup hover timer to unlock after 1.2s of hovering\n  setupCardHoverUnlocks();\n}\n\nfunction setupCardHoverUnlocks() {\n  const cards = document.querySelectorAll(\".destination-card\");\n  cards.forEach((card) => {\n    let hoverTimer = null;\n    const destId = card.getAttribute(\"data-id\");\n\n    card.addEventListener(\"mouseenter\", () => {\n      hoverTimer = setTimeout(() => {\n        unlockDestination(destId);\n      }, 1200);\n    });\n\n    card.addEventListener(\"mouseleave\", () => {\n      if (hoverTimer) clearTimeout(hoverTimer);\n    });\n  });\n}\n\nfunction renderDidYouKnowFacts() {\n  const factsContainer = document.getElementById(\"facts-container\");\n  if (!factsContainer || typeof DID_YOU_KNOW_FACTS === \"undefined\") return;\n\n  factsContainer.innerHTML = DID_YOU_KNOW_FACTS.map((fact) => `\n    <div class=\"fact-card fade-up\">\n      <div class=\"fact-num\">${fact.number}</div>\n      <div class=\"fact-tag\">${fact.tag}</div>\n      <h3 class=\"fact-headline\">${fact.headline}</h3>\n      <p class=\"fact-body\">${fact.body}</p>\n    </div>\n  `).join(\"\");\n}\n\nfunction renderTravelThemes() {\n  const themesContainer = document.getElementById(\"themes-grid\");\n  if (!themesContainer || typeof TRAVEL_THEMES === \"undefined\") return;\n\n  themesContainer.innerHTML = TRAVEL_THEMES.map((theme) => `\n    <div class=\"theme-card fade-up\">\n      <div class=\"theme-bg\">\n        <img src=\"${theme.image}\" alt=\"${theme.title}\" class=\"theme-img\" loading=\"lazy\" />\n        <div class=\"theme-overlay\"></div>\n      </div>\n      <div class=\"theme-content\">\n        <span class=\"theme-count\">${theme.count}</span>\n        <h3 class=\"theme-title\">${theme.title}</h3>\n        <p class=\"theme-sub\">${theme.subtitle}</p>\n      </div>\n    </div>\n  `).join(\"\");\n}\n\n/* ==========================================================================\n   5. CATEGORY FILTERS\n   ========================================================================== */\nfunction initCategoryFilters() {\n  const filterChips = document.querySelectorAll(\".filter-chip\");\n\n  filterChips.forEach((chip) => {\n    chip.addEventListener(\"click\", () => {\n      filterChips.forEach((c) => c.classList.remove(\"active\"));\n      chip.classList.add(\"active\");\n\n      const selectedCategory = chip.dataset.category.toLowerCase();\n      const destinationCards = document.querySelectorAll(\".destination-card\");\n\n      destinationCards.forEach((card) => {\n        const cardCat = card.dataset.category || \"\";\n        if (selectedCategory === \"all\" || cardCat.includes(selectedCategory)) {\n          card.style.display = \"flex\";\n          setTimeout(() => {\n            card.classList.add(\"in-view\");\n          }, 50);\n        } else {\n          card.style.display = \"none\";\n        }\n      });\n    });\n  });\n}\n\n/* ==========================================================================\n   6. 3D CARD TILT MICRO-INTERACTION (DESKTOP ONLY)\n   ========================================================================== */\nfunction initCard3DTilt() {\n  const isFinePointer = window.matchMedia(\"(hover: hover) and (pointer: fine)\").matches;\n  if (!isFinePointer) return;\n\n  document.addEventListener(\"mousemove\", (e) => {\n    const card = e.target.closest(\".destination-card\");\n    if (!card) return;\n\n    const rect = card.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n\n    const centerX = rect.width / 2;\n    const centerY = rect.height / 2;\n\n    const rotateX = ((y - centerY) / centerY) * -6;\n    const rotateY = ((x - centerX) / centerX) * 6;\n\n    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-8px)`;\n  });\n\n  document.addEventListener(\"mouseout\", (e) => {\n    const card = e.target.closest(\".destination-card\");\n    if (card && !card.contains(e.relatedTarget)) {\n      card.style.transform = \"\";\n    }\n  });\n}\n\n/* ==========================================================================\n   7. DESKTOP CUSTOM CURSOR FOLLOWER FOR CARDS\n   ========================================================================== */\nfunction initCardCursorFollower() {\n  const follower = document.getElementById(\"card-cursor-follower\");\n  if (!follower) return;\n\n  const isFinePointer = window.matchMedia(\"(hover: hover) and (pointer: fine)\").matches;\n  if (!isFinePointer) return;\n\n  let mouseX = 0, mouseY = 0;\n  let followerX = 0, followerY = 0;\n  let isHoveringCard = false;\n\n  document.addEventListener(\"mousemove\", (e) => {\n    mouseX = e.clientX;\n    mouseY = e.clientY;\n\n    const targetCard = e.target.closest(\".destination-card, .theme-card\");\n    if (targetCard) {\n      if (!isHoveringCard) {\n        follower.classList.add(\"active\");\n        follower.textContent = \"EXPLORE\";\n        isHoveringCard = true;\n      }\n    } else {\n      if (isHoveringCard) {\n        follower.classList.remove(\"active\");\n        isHoveringCard = false;\n      }\n    }\n  });\n\n  function animateFollower() {\n    followerX += (mouseX - followerX) * 0.18;\n    followerY += (mouseY - followerY) * 0.18;\n\n    follower.style.transform = `translate3d(${followerX}px, ${followerY}px, 0) ${isHoveringCard ? 'scale(1)' : 'scale(0.5)'}`;\n    requestAnimationFrame(animateFollower);\n  }\n\n  animateFollower();\n}\n\n/* ==========================================================================\n   8. 5-STAMP GAMIFIED UNLOCK ENGINE & PASSPORT SYSTEM\n   ========================================================================== */\n\nfunction loadPassportProgress() {\n  try {\n    const saved = localStorage.getItem(\"jharkhand_unlocked_places_5\");\n    if (saved) {\n      unlockedDestinations = JSON.parse(saved);\n    }\n  } catch (err) {\n    unlockedDestinations = [];\n  }\n  calculateTotalXP();\n}\n\nfunction savePassportProgress() {\n  try {\n    localStorage.setItem(\"jharkhand_unlocked_places_5\", JSON.stringify(unlockedDestinations));\n  } catch (err) {}\n  calculateTotalXP();\n  updatePassportUI();\n}\n\nfunction calculateTotalXP() {\n  totalScoreXP = unlockedDestinations.reduce((acc, id) => {\n    const dest = FAMOUS_DESTINATIONS.find((d) => d.id === id);\n    return acc + (dest ? dest.xpReward : 200);\n  }, 0);\n}\n\nfunction getExplorerRankTitle() {\n  const count = unlockedDestinations.length;\n  if (count === 0) return \"Novice Tourist\";\n  if (count === 1) return \"Forest Wanderer\";\n  if (count === 2) return \"Ghat Explorer\";\n  if (count === 3) return \"Pilgrim Adventurer\";\n  if (count === 4) return \"Plateau Trailblazer\";\n  return \"Grand Master of Jharkhand 👑\";\n}\n\nfunction unlockDestination(destinationId) {\n  if (unlockedDestinations.includes(destinationId)) return;\n\n  const destination = FAMOUS_DESTINATIONS.find((d) => d.id === destinationId);\n  if (!destination) return;\n\n  unlockedDestinations.push(destinationId);\n  savePassportProgress();\n\n  // 1. Show Celebration Confetti\n  triggerUnlockConfetti();\n\n  // 2. Show Celebration Toast Notification\n  showUnlockToast(destination);\n\n  // 3. Update Card Visual\n  const card = document.querySelector(`.destination-card[data-id=\"${destinationId}\"]`);\n  if (card) {\n    card.classList.add(\"is-unlocked\");\n    const badgeContainer = card.querySelector(\".badge-famous\");\n    if (badgeContainer) {\n      badgeContainer.outerHTML = `<span class=\"badge-famous badge-unlocked\">🏆 Stamp Collected</span>`;\n    }\n    const exploreBtn = card.querySelector(\".card-explore-btn\");\n    if (exploreBtn) {\n      exploreBtn.innerHTML = `View Passport Stamp <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>`;\n    }\n  }\n\n  // If all 5 collected, trigger ultimate celebration\n  if (unlockedDestinations.length === FAMOUS_DESTINATIONS.length) {\n    setTimeout(() => {\n      triggerEpicGatewayExplosion();\n    }, 1500);\n  }\n}\n\nfunction showUnlockToast(dest) {\n  let toast = document.getElementById(\"unlock-toast\");\n  if (!toast) {\n    toast = document.createElement(\"div\");\n    toast.id = \"unlock-toast\";\n    toast.className = \"unlock-toast\";\n    document.body.appendChild(toast);\n  }\n\n  toast.innerHTML = `\n    <div class=\"unlock-toast-icon\">${dest.stampIcon || '🌟'}</div>\n    <div>\n      <div class=\"unlock-toast-title\">Stamp Collected: ${dest.stampTitle || 'EXPLORER'}</div>\n      <div class=\"unlock-toast-place\">${dest.name}</div>\n      <div class=\"unlock-toast-xp\">+${dest.xpReward} Explorer XP • Total: ${totalScoreXP} XP</div>\n    </div>\n  `;\n\n  toast.classList.add(\"show\");\n\n  setTimeout(() => {\n    toast.classList.remove(\"show\");\n  }, 4500);\n}\n\nfunction updatePassportUI() {\n  const countSpan = document.getElementById(\"passport-count-badge\");\n  if (countSpan) {\n    countSpan.textContent = `${unlockedDestinations.length}/${FAMOUS_DESTINATIONS.length}`;\n  }\n}\n\nfunction openPassportModal() {\n  const modalBackdrop = document.getElementById(\"passport-modal-backdrop\");\n  const stampsGrid = document.getElementById(\"passport-stamps-grid\");\n  const rankElem = document.getElementById(\"passport-user-rank\");\n  const levelElem = document.getElementById(\"passport-level-pill\");\n  if (!modalBackdrop || !stampsGrid) return;\n\n  if (rankElem) rankElem.textContent = getExplorerRankTitle();\n  if (levelElem) levelElem.textContent = `${unlockedDestinations.length}/${FAMOUS_DESTINATIONS.length} Stamps (${totalScoreXP} XP)`;\n\n  stampsGrid.innerHTML = FAMOUS_DESTINATIONS.map((dest) => {\n    const isUnlocked = unlockedDestinations.includes(dest.id);\n    if (isUnlocked) {\n      return `\n        <div class=\"passport-stamp-slot unlocked\">\n          <span class=\"stamp-seal-badge\">${dest.stampTitle || 'OFFICIAL STAMP'}</span>\n          <img src=\"${dest.thumbnail}\" alt=\"${dest.name}\" class=\"stamp-thumbnail-mini\" />\n          <h4 class=\"stamp-place-name\">${dest.name}</h4>\n          <p class=\"stamp-clue\" style=\"color: #34D399;\">${dest.category} • +${dest.xpReward} XP</p>\n          <button class=\"btn-primary\" style=\"padding: 0.35rem 0.75rem; font-size: 0.7rem; margin-top: 0.5rem;\" onclick=\"closePassportModal(); openDestinationModal('${dest.id}');\">\n            View Details\n          </button>\n        </div>\n      `;\n    } else {\n      return `\n        <div class=\"passport-stamp-slot\">\n          <div class=\"stamp-locked-icon\">🔒</div>\n          <h4 class=\"stamp-place-name\" style=\"opacity: 0.7;\">${dest.name}</h4>\n          <p class=\"stamp-clue\">\"${dest.unlockClue}\"</p>\n          <button class=\"btn-secondary\" style=\"padding: 0.35rem 0.75rem; font-size: 0.7rem; margin-top: 0.5rem;\" onclick=\"closePassportModal(); openDestinationModal('${dest.id}');\">\n            Collect Stamp\n          </button>\n        </div>\n      `;\n    }\n  }).join(\"\");\n\n  modalBackdrop.classList.add(\"open\");\n  document.body.style.overflow = \"hidden\";\n}\n\nfunction closePassportModal() {\n  const modalBackdrop = document.getElementById(\"passport-modal-backdrop\");\n  if (modalBackdrop) {\n    modalBackdrop.classList.remove(\"open\");\n    document.body.style.overflow = \"\";\n  }\n}\n\nfunction unlockAllPlacesDemo() {\n  unlockedDestinations = FAMOUS_DESTINATIONS.map((d) => d.id);\n  savePassportProgress();\n  renderFamousDestinations();\n  openPassportModal();\n  triggerEpicGatewayExplosion();\n}\n\nwindow.openPassportModal = openPassportModal;\nwindow.closePassportModal = closePassportModal;\nwindow.unlockAllPlacesDemo = unlockAllPlacesDemo;\n\n/* ==========================================================================\n   9. CANVAS CONFETTI ENGINE (PURE VANILLA JAVASCRIPT)\n   ========================================================================== */\nlet confettiCanvas, confettiCtx;\nlet confettiParticles = [];\n\nfunction initConfettiCanvas() {\n  confettiCanvas = document.getElementById(\"unlock-confetti-canvas\");\n  if (!confettiCanvas) {\n    confettiCanvas = document.createElement(\"canvas\");\n    confettiCanvas.id = \"unlock-confetti-canvas\";\n    document.body.appendChild(confettiCanvas);\n  }\n  confettiCtx = confettiCanvas.getContext(\"2d\");\n\n  function resizeCanvas() {\n    confettiCanvas.width = window.innerWidth;\n    confettiCanvas.height = window.innerHeight;\n  }\n  resizeCanvas();\n  window.addEventListener(\"resize\", resizeCanvas);\n}\n\nfunction triggerUnlockConfetti() {\n  if (!confettiCtx) return;\n\n  const colors = [\"#C5A059\", \"#DFC27D\", \"#10B981\", \"#34D399\", \"#FFFFFF\", \"#F59E0B\"];\n  const particleCount = 75;\n\n  for (let i = 0; i < particleCount; i++) {\n    confettiParticles.push({\n      x: window.innerWidth / 2 + (Math.random() - 0.5) * 200,\n      y: window.innerHeight * 0.35,\n      vx: (Math.random() - 0.5) * 16,\n      vy: Math.random() * -14 - 4,\n      size: Math.random() * 8 + 4,\n      color: colors[Math.floor(Math.random() * colors.length)],\n      rotation: Math.random() * 360,\n      rotationSpeed: (Math.random() - 0.5) * 12,\n      opacity: 1,\n      gravity: 0.45\n    });\n  }\n\n  if (confettiParticles.length === particleCount) {\n    animateConfetti();\n  }\n}\n\nfunction animateConfetti() {\n  if (!confettiParticles.length) {\n    confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);\n    return;\n  }\n\n  confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);\n\n  for (let i = confettiParticles.length - 1; i >= 0; i--) {\n    const p = confettiParticles[i];\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += p.gravity;\n    p.rotation += p.rotationSpeed;\n    p.opacity -= 0.012;\n\n    if (p.opacity <= 0 || p.y > window.innerHeight) {\n      confettiParticles.splice(i, 1);\n      continue;\n    }\n\n    confettiCtx.save();\n    confettiCtx.translate(p.x, p.y);\n    confettiCtx.rotate((p.rotation * Math.PI) / 180);\n    confettiCtx.fillStyle = p.color;\n    confettiCtx.globalAlpha = p.opacity;\n    confettiCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);\n    confettiCtx.restore();\n  }\n\n  requestAnimationFrame(animateConfetti);\n}\n\n/* ==========================================================================\n   10. FULL-SCREEN IMMERSIVE DESTINATION DETAILS MODAL\n   ========================================================================== */\nfunction openDestinationModal(destinationId) {\n  unlockDestination(destinationId);\n\n  const destination = FAMOUS_DESTINATIONS.find((d) => d.id === destinationId);\n  if (!destination) return;\n\n  const modalBackdrop = document.getElementById(\"destination-modal-backdrop\");\n  const modalContainer = document.getElementById(\"destination-modal-content\");\n  if (!modalBackdrop || !modalContainer) return;\n\n  modalContainer.innerHTML = `\n    <div class=\"modal-hero\">\n      <img src=\"${destination.heroImage}\" alt=\"${destination.name}\" class=\"modal-hero-img\" />\n      <div class=\"modal-hero-overlay\"></div>\n      <div class=\"modal-hero-text\">\n        <div class=\"modal-badge-row\">\n          <span class=\"badge-famous badge-unlocked\">🏆 Official Passport Stamp</span>\n          <span class=\"card-district\">${destination.district} District</span>\n        </div>\n        <h2 class=\"modal-title\">${destination.name}</h2>\n        <p class=\"modal-tagline\">\"${destination.tagline}\"</p>\n      </div>\n    </div>\n\n    <div class=\"modal-body\">\n      <div class=\"modal-grid-layout\">\n        <!-- Main Narrative Column -->\n        <div class=\"modal-main-content\">\n          <h3 class=\"modal-section-title\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n              <line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"></line>\n              <line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"></line>\n            </svg>\n            About This Wonder\n          </h3>\n          <p class=\"modal-main-desc\">${destination.description}</p>\n\n          <h3 class=\"modal-section-title\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n            </svg>\n            Key Highlights\n          </h3>\n          <ul class=\"modal-highlights-list\">\n            ${destination.highlights.map((h) => `\n              <li class=\"modal-highlight-item\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <polyline points=\"20 6 9 17 4 12\"></polyline>\n                </svg>\n                <span>${h}</span>\n              </li>\n            `).join(\"\")}\n          </ul>\n        </div>\n\n        <!-- Quick Facts Sidebar -->\n        <div class=\"modal-sidebar-card\">\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Category</span>\n            <span class=\"info-val\">${destination.category}</span>\n          </div>\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Location</span>\n            <span class=\"info-val\">${destination.location}</span>\n          </div>\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Elevation</span>\n            <span class=\"info-val\">${destination.elevation}</span>\n          </div>\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Best Season</span>\n            <span class=\"info-val\">${destination.bestTimeToVisit}</span>\n          </div>\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Visiting Hours</span>\n            <span class=\"info-val\">${destination.timings}</span>\n          </div>\n          <div class=\"modal-info-row\">\n            <span class=\"info-label\">Entry Ticket</span>\n            <span class=\"info-val\">${destination.entryFee}</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Safety Information Section (Precaution & Major Warning) -->\n      <div>\n        <h3 class=\"modal-section-title\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n          </svg>\n          Visitor Safety & Advisory\n        </h3>\n        <div class=\"safety-cards-container\">\n          <!-- Precaution Card -->\n          <div class=\"safety-card-precaution\">\n            <div class=\"safety-header\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n              </svg>\n              PRECAUTION\n            </div>\n            <p class=\"safety-body\">${destination.safety.precaution}</p>\n          </div>\n\n          <!-- Major Safety Warning Card -->\n          <div class=\"safety-card-warning\">\n            <div class=\"safety-header\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"></path>\n                <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line>\n                <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n              </svg>\n              MAJOR SAFETY WARNING\n            </div>\n            <p class=\"safety-body\">${destination.safety.majorWarning}</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- How to Reach Transit Box -->\n      <div class=\"transit-box\">\n        <h4 class=\"transit-title\" style=\"margin-bottom: 1rem;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n            <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n            <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n            <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          </svg>\n          How to Reach\n        </h4>\n        <div class=\"transit-grid\">\n          <div class=\"transit-item\">\n            <span class=\"transit-title\">By Air</span>\n            <span class=\"transit-desc\">${destination.howToReach.byAir}</span>\n          </div>\n          <div class=\"transit-item\">\n            <span class=\"transit-title\">By Train</span>\n            <span class=\"transit-desc\">${destination.howToReach.byTrain}</span>\n          </div>\n          <div class=\"transit-item\">\n            <span class=\"transit-title\">By Road</span>\n            <span class=\"transit-desc\">${destination.howToReach.byRoad}</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Modal Footer Actions -->\n      <div class=\"modal-footer-actions\">\n        <span class=\"coordinates-pill\">\n          GPS: ${destination.coordinates.lat.toFixed(4)}° N, ${destination.coordinates.lng.toFixed(4)}° E\n        </span>\n\n        <button class=\"btn-primary\" onclick=\"closeDestinationModal(); focusDestinationOnMap('${destination.id}');\">\n          <span>View on Interactive Map</span>\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polygon points=\"3 11 22 2 13 21 11 13 3 11\"></polygon>\n          </svg>\n        </button>\n      </div>\n    </div>\n  `;\n\n  modalBackdrop.classList.add(\"open\");\n  document.body.style.overflow = \"hidden\";\n}\n\nfunction closeDestinationModal() {\n  const modalBackdrop = document.getElementById(\"destination-modal-backdrop\");\n  if (modalBackdrop) {\n    modalBackdrop.classList.remove(\"open\");\n    document.body.style.overflow = \"\";\n  }\n}\n\ndocument.addEventListener(\"keydown\", (e) => {\n  if (e.key === \"Escape\") {\n    closeDestinationModal();\n    closePassportModal();\n  }\n});\n\ndocument.addEventListener(\"click\", (e) => {\n  const backdrop = document.getElementById(\"destination-modal-backdrop\");\n  if (backdrop && e.target === backdrop) {\n    closeDestinationModal();\n  }\n  const passBackdrop = document.getElementById(\"passport-modal-backdrop\");\n  if (passBackdrop && e.target === passBackdrop) {\n    closePassportModal();\n  }\n});\n\nwindow.openDestinationModal = openDestinationModal;\nwindow.closeDestinationModal = closeDestinationModal;\n\n/* ==========================================================================\n   11. STAT COUNTER ANIMATION\n   ========================================================================== */\nfunction initStatCounters() {\n  const statNumbers = document.querySelectorAll(\".stat-number[data-target]\");\n  if (!statNumbers.length) return;\n\n  const observer = new IntersectionObserver((entries, obs) => {\n    entries.forEach((entry) => {\n      if (entry.isIntersecting) {\n        const el = entry.target;\n        const target = parseFloat(el.getAttribute(\"data-target\"));\n        const suffix = el.getAttribute(\"data-suffix\") || \"\";\n        const duration = 1800;\n        const startTime = performance.now();\n\n        function updateCounter(currentTime) {\n          const elapsed = currentTime - startTime;\n          const progress = Math.min(elapsed / duration, 1);\n          const easeProgress = 1 - Math.pow(1 - progress, 3);\n          const currentVal = Math.floor(easeProgress * target);\n\n          el.textContent = currentVal.toLocaleString() + suffix;\n\n          if (progress < 1) {\n            requestAnimationFrame(updateCounter);\n          } else {\n            el.textContent = target.toLocaleString() + suffix;\n          }\n        }\n\n        requestAnimationFrame(updateCounter);\n        obs.unobserve(el);\n      }\n    });\n  }, { threshold: 0.5 });\n\n  statNumbers.forEach((num) => observer.observe(num));\n}\n\n/* ==========================================================================\n   12. SCROLL REVEAL (INTERSECTION OBSERVER)\n   ========================================================================== */\nfunction initScrollReveals() {\n  const revealElements = document.querySelectorAll(\".fade-up\");\n\n  const observer = new IntersectionObserver(\n    (entries, obs) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add(\"in-view\");\n          obs.unobserve(entry.target);\n        }\n      });\n    },\n    {\n      root: null,\n      threshold: 0.12,\n      rootMargin: \"0px 0px -40px 0px\"\n    }\n  );\n\n  revealElements.forEach((el) => observer.observe(el));\n}\n","Description":"Update app.js with crazy vault gateway unlock animation, 5 stamps passport logic and shockwave VFX","Overwrite":true,"TargetFile":"C:\\Users\\Bhavish Sawant\\.gemini\\antigravity\\scratch\\jharkhand-tourism\\js\\app.js","toolAction":"Updating app.js","toolSummary":"Updating app.js"}}]}
